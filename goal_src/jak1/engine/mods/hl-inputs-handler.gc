(in-package goal)

(define *hl-target-jump-buffer* 0)
(defconstant hl-target-jump-buffer-time (seconds 0.2))
(define *last-duck-time* 0)
(defconstant duck-cooldown (fsec 0.12))

(defun in-hl-state? ()
  (and (= (-> *target* game mode) 'play) (or (-> *target* state name) 'target-hl-movement-ground 'target-hl-movement-ground-duck 'target-hl-movement-air 'target-hl-movement-air-duck) (!= (-> *target* state name) 'target-hl-periscope) (!= (-> *target* state name) 'target-hl-death)))

(defun target-sleeping? ()
  (nonzero? (logand (-> *target* mask)
                    (process-mask sleep))))

(defun clear-keyboard-edge-pressed! ()
  (set! (-> *keyboard-edge* enter-pressed) 0)
  (set! (-> *keyboard-edge* space-pressed) 0)
  (set! (-> *keyboard-edge* esc-pressed) 0)
  (set! (-> *keyboard-edge* up-pressed) 0)
  (set! (-> *keyboard-edge* down-pressed) 0)
  (set! (-> *keyboard-edge* left-pressed) 0)
  (set! (-> *keyboard-edge* right-pressed) 0)
  (set! (-> *keyboard-edge* one-pressed) 0)
  (set! (-> *keyboard-edge* two-pressed) 0)
  (set! (-> *keyboard-edge* three-pressed) 0)
  (set! (-> *keyboard-edge* four-pressed) 0)
  (set! (-> *keyboard-edge* backspace-pressed) 0)
  (set! (-> *keyboard-edge* e-pressed) 0)
  (set! (-> *keyboard-edge* q-pressed) 0)
  (set! (-> *keyboard-edge* period-pressed) 0)
  (set! (-> *keyboard-edge* tab-pressed) 0)
  (set! (-> *keyboard-edge* ctrl-pressed) 0)
  (set! (-> *keyboard-edge* a-pressed) 0)
  (set! (-> *keyboard-edge* d-pressed) 0)
  (set! (-> *keyboard-edge* comma-pressed) 0))

(defun clear-mouse-edge-pressed! ()
  (set! (-> *mouse-edge* mouse1-pressed) 0)
  (set! (-> *mouse-edge* mouse2-pressed) 0))

(defmacro update-key-edge (key held pressed)
  `(if (!= (-> *keyboard-data* ,key) 0)
       (when (= (-> *keyboard-edge* ,held) 0)
         (set! (-> *keyboard-edge* ,held) 1)
         (set! (-> *keyboard-edge* ,pressed) 1))
       (begin
         (set! (-> *keyboard-edge* ,held) 0))))

(defmacro update-mouse-edge (button held pressed)
  `(if (!= (-> *mouse-data* ,button) 0)
       (when (= (-> *mouse-edge* ,held) 0)
         (set! (-> *mouse-edge* ,held) 1)
         (set! (-> *mouse-edge* ,pressed) 1))
       (begin
         (set! (-> *mouse-edge* ,held) 0))))

(defmacro key-status? (key)
  `(!= (-> *keyboard-edge* ,key) 0))

(defun update-keyboard-input-stuff ()
  (clear-keyboard-edge-pressed!)
  (pc-get-keyboard-data *keyboard-data*)
  ;; ENTER
  (update-key-edge key_enter enter-held enter-pressed)
  ;; SPACE
  (update-key-edge key_space space-held space-pressed)
  ;; ESC
  (update-key-edge key_esc esc-held esc-pressed)
  ;; UP
  (update-key-edge key_up up-held up-pressed)
  ;; DOWN
  (update-key-edge key_down down-held down-pressed)
  ;; LEFT
  (update-key-edge key_left left-held left-pressed)
  ;; RIGHT
  (update-key-edge key_right right-held right-pressed)
  ;; 1
  (update-key-edge key_1 one-held one-pressed)
  ;; 2
  (update-key-edge key_2 two-held two-pressed)
  ;; 3
  (update-key-edge key_3 three-held three-pressed)
  ;; 4
  (update-key-edge key_4 four-held four-pressed)
  ;; BACKSPACE
  (update-key-edge key_backspace backspace-held backspace-pressed)
  ;; E
  (update-key-edge key_e e-held e-pressed)
  ;; Q
  (update-key-edge key_q q-held q-pressed)
  ;; PERIOD
  (update-key-edge key_period period-held period-pressed)
  ;; TAB
  (update-key-edge key_tab tab-held tab-pressed)
  ;; CTRL
  (update-key-edge key_ctrl ctrl-held ctrl-pressed)
  ;; A
  (update-key-edge key_a a-held a-pressed)
  ;; D
  (update-key-edge key_d d-held d-pressed)
  ;; COMMA
  (update-key-edge key_comma comma-held comma-pressed))

(defun update-mouse-input-stuff ()
  (clear-mouse-edge-pressed!)
  (if (and (not (movie?)) (not (paused?)) (not (target-sleeping?)))
    (begin
      (pc-get-mouse-data *mouse-data*))
    (begin 
      (set! (-> *mouse-data* mouse-relx) 0.0)
      (set! (-> *mouse-data* mouse-rely) 0.0)
    )
    )
  ;;(format 0 "~f ~f~%" (-> *mouse-data* mouse-relx) (-> *mouse-data* mouse-rely))
  ;; Mouse 1
  (update-mouse-edge mouse1 mouse1-held mouse1-pressed)
  ;; Mouse 2
  (update-mouse-edge mouse2 mouse2-held mouse2-pressed))


(defun mouse-wheel-jump? ()
  (unless (= (-> *pc-settings* mouse-wheel-behavior) 0)
    (cond
      ((= (-> *pc-settings* mouse-wheel-behavior) 1)
        (< (-> *mouse-data* mouse-scrolly) 0.0)
      )
      ((= (-> *pc-settings* mouse-wheel-behavior) 2)
        (> (-> *mouse-data* mouse-scrolly) 0.0)
      )
      ((or (= (-> *pc-settings* mouse-wheel-behavior) 2) (= (-> *pc-settings* mouse-wheel-behavior) 3))
        (!= (-> *mouse-data* mouse-scrolly) 0.0)
      )
    )    
))

(defun should-update-jump-buffer? ()
 (when (and (or (mouse-wheel-jump?) (cpad-pressed? 0 l1)) (not (paused?)))
  (set-time! *hl-target-jump-buffer*)))

(defun should-jump? ()
  (if (= (-> *target* state name) 'target-hl-fishing)
    #f
    (begin
      (if (-> *pc-settings* auto-jump?)
        (begin 
          (when (and (not (paused?)) (or (not (time-elapsed? *hl-target-jump-buffer* hl-target-jump-buffer-time)) (cpad-hold? 0 l1))) #t))
        (begin
          (when (and (not (paused?)) (not (time-elapsed? *hl-target-jump-buffer* hl-target-jump-buffer-time))) #t))))
  )
)

(defun pressed-jump? ()
  (when (and (not (paused?)) (not (time-elapsed? *hl-target-jump-buffer* hl-target-jump-buffer-time))) #t)
)

(defun should-swim-up? ()
  (or (cpad-hold? 0 l1) (should-jump?))
)

(defun should-move-forward? ()
  (< (-> *cpad-list* cpads 0 lefty)(- 127 (* 128.0 (-> *pc-settings* stick-deadzone))))
  ;;(!= (-> *keyboard-data* key_w) 0)
)

(defun should-move-back? ()
  (> (-> *cpad-list* cpads 0 lefty) (+ 127 (* 128.0 (-> *pc-settings* stick-deadzone))))
  ;;(!= (-> *keyboard-data* key_s) 0)
)

(defun should-move-left? ()
  (< (-> *cpad-list* cpads 0 leftx) (- 127 (* 128.0 (-> *pc-settings* stick-deadzone))))
  ;;(!= (-> *keyboard-data* key_a) 0)
)

(defun should-move-right? ()
  (> (-> *cpad-list* cpads 0 leftx) (+ 127(* 128.0 (-> *pc-settings* stick-deadzone))))
  ;;(!= (-> *keyboard-data* key_d) 0)
)

(defun should-be-moving? ()
  (or (should-move-forward?) (should-move-back?) (should-move-left?) (should-move-right?))
)

(defun raw-duck-input? ()
  (or (> (-> *mouse-data* mouse-scrolly) 0.0)
      (cpad-hold? 0 l2)))

(defun mouse-wheel-duck? ()
  (unless (or (= (-> *pc-settings* mouse-wheel-behavior) 0) (= (-> *pc-settings* mouse-wheel-behavior) 3))
    (if (= (-> *pc-settings* mouse-wheel-behavior) 1)
      (> (-> *mouse-data* mouse-scrolly) 0.0)
      (< (-> *mouse-data* mouse-scrolly) 0.0))))


(defun should-duck? ()
  (cond
    ((cpad-hold? 0 l2) #t)
    ;; To prevent crouch spamming so we dont continuously gain height due to our crouching approach differing from HL
    ((and (or (mouse-wheel-duck?) (cpad-pressed? 0 l2))
          (time-elapsed? *last-duck-time* duck-cooldown))
     (set-time! *last-duck-time*)
     #t)

    (else #f)))

(defun should-walk? ()
  (cpad-hold? 0 l3)
  ;;(!= (-> *keyboard-data* key_shift) 0)
)

(defun should-reload? ()
  (and (!= (-> *target* state name) 'target-hl-death) (cpad-hold? 0 square) (not (paused?)) (not (movie?)) (not (= (-> *target* state name) 'target-hl-grab)))
)

(defun should-attack? ()
  (and (in-hl-state?) (not (paused?))(or (!= (-> *mouse-data* mouse1) 0) (cpad-hold? 0 r1))))

(defun mouse1? ()
  (!= (-> *mouse-data* mouse1) 0))

(defun should-second-attack? ()
  (and (in-hl-state?) (not (paused?)) (or (!= (-> *mouse-data* mouse2) 0) (cpad-hold? 0 r2)))
)

(defun should-switch-slot1? ()
  (and (or (key-status? one-pressed) (cpad-pressed? 0 left)) (not (paused?)) (!= (-> *target* state name) 'target-hl-grab) (!= (-> *target* state name) 'target-hl-fishing))
)

(defun should-switch-slot2? ()
  (and (or (key-status? two-pressed) (cpad-pressed? 0 up)) (not (paused?)) (!= (-> *target* state name) 'target-hl-grab) (!= (-> *target* state name) 'target-hl-fishing))
)

(defun should-switch-slot3? ()
  (and (or (key-status? three-pressed) (cpad-pressed? 0 right)) (not (paused?)) (!= (-> *target* state name) 'target-hl-grab) (!= (-> *target* state name) 'target-hl-fishing))
)

(defun should-switch-slot4? ()
  (and (or (key-status? four-pressed) (cpad-pressed? 0 down)) (not (paused?)) (!= (-> *target* state name) 'target-hl-grab) (!= (-> *target* state name) 'target-hl-fishing))
)

(defun should-use? () #f)
;  (key-status? e-pressed))

(defun should-exit? ()
  (or (key-status? backspace-pressed) (cpad-pressed? 0 triangle)))

(defun should-switch-last-weapon? ()
  ;; Controller mode has no last weapon switch
  (and (not (-> *pc-settings* controller-aim?)) (cpad-pressed? 0 x) (not (paused?)) (!= (-> *target* state name) 'target-hl-fishing)))

(defun should-show-hud? ()
  (cpad-pressed? 0 r3))

(defun should-do-double-jump? ()
  ;; In controller mode we use X to double jump
  (if (-> *pc-settings* controller-aim?)
    (cpad-pressed? 0 x)
    (should-walk?))
)

(defun should-do-duck-high-jump? ()
  ;;(and (should-duck?) (should-walk?))
  (should-duck?)
)

(defun get-use-bind-string ()
  (let ((info (new 'static 'bind-assignment-info)))
    (set! (-> info device-type) 1)
    (set! (-> info port) 0)
    (set! (-> info for-buttons?) #t)
    (set! (-> info input-idx) 13)
    (set! (-> info analog-min-range?) #f)

    (if (pc-get-current-bind info *pc-cpp-temp-string*)
        *pc-cpp-temp-string*
        #f)))

(defun clear-keyboard ((kb keyboard-info))
  (set! (-> kb key_w) 0)
  (set! (-> kb key_a) 0)
  (set! (-> kb key_s) 0)
  (set! (-> kb key_d) 0)
  (set! (-> kb key_r) 0)
  (set! (-> kb key_q) 0)
  (set! (-> kb key_e) 0)
  (set! (-> kb key_space) 0)
  (set! (-> kb key_shift) 0)
  (set! (-> kb key_ctrl) 0)
  (set! (-> kb key_alt) 0)
  (set! (-> kb key_esc) 0)
  (set! (-> kb key_enter) 0)
  (set! (-> kb key_1) 0)
  (set! (-> kb key_2) 0)
  (set! (-> kb key_3) 0)
  (set! (-> kb key_4) 0))

(defun clear-mouse ((mouse mouse-info))
  (set! (-> mouse mouse1) 0)
  (set! (-> mouse mouse2) 0)
  (set! (-> mouse mouse-relx) 0.0)
  (set! (-> mouse mouse-rely) 0.0)
  (set! (-> mouse mouse-scrolly) 0.0))

(defbehavior target-hl-is-in-duck? target ()
  (or (= (-> self state name) 'target-hl-movement-ground-duck) (= (-> self state name) 'target-hl-movement-air-duck) 
    (= (-> self state name) 'target-hl-movement-air-jump-duck)))
#|
(defbehavior read-input target ((arg0 vector))
  (when (!= (-> self control pad-read-time) (-> *display* real-frame-counter))
    (set! (-> self control last-stick-vec quad) (-> self control stick-vec quad))
    (set! (-> self control last-pad-stick-speed) (-> self control pad-stick-speed))
    (set! (-> self control pad-read-time) (the-as uint (-> *display* real-frame-counter))))

  (set! (-> arg0 x) 0.0)
  (set! (-> arg0 y) 0.0)
  (set! (-> arg0 z) 0.0)
  (set! (-> arg0 w) 0.0)

  (when (should-move-forward?) (set! (-> arg0 z) (+ (-> arg0 z) 1.0)))
  (when (should-move-back?)    (set! (-> arg0 z) (- (-> arg0 z) 1.0)))
  (when (should-move-left?)    (set! (-> arg0 x) (+ (-> arg0 x) 1.0)))
  (when (should-move-right?)   (set! (-> arg0 x) (- (-> arg0 x) 1.0)))

  (let ((has-input (> (vector-length arg0) 0.0)))
    (if has-input
        (begin
          (vector-normalize! arg0 1.0)
          (set! (-> self control stick-vec quad) (-> arg0 quad))
          (let ((base-speed (if (should-walk?) 0.48 1.5))
                (duck-mult (if (target-hl-is-in-duck?) 0.3 1.0)))
            (set! (-> self control pad-stick-speed) (* base-speed duck-mult)))
          (vector-matrix*! arg0 arg0 (matrix-local->world #t #f))
))))|#

(defun movement-speed-multiplier ()
  (cond
    ((target-hl-is-in-duck?) 0.4125)
    ((should-walk?) 0.465)
    (else 1.5)))

(defbehavior read-input target ((arg0 vector))
  ;; frame sync
  (when (!= (-> self control pad-read-time) (-> *display* real-frame-counter))
    (set! (-> self control last-stick-vec quad) (-> self control stick-vec quad))
    (set! (-> self control last-pad-stick-speed) (-> self control pad-stick-speed))
    (set! (-> self control pad-read-time) (the-as uint (-> *display* real-frame-counter))))

  ;; fill arg0 with controller analog (angle-based)
  (set! (-> arg0 x) (sin (-> self control cpad stick0-dir)))
  (set! (-> arg0 y) 0.0)
  (set! (-> arg0 z) (cos (-> self control cpad stick0-dir)))
  (set! (-> arg0 w) 0.0)

  ;; no need to normalize — the direction is already correct from sin/cos

  ;; store the quad for other systems
  (set! (-> self control stick-vec quad) (-> arg0 quad))

  ;; scale pad-stick-speed by analog magnitude * walk/duck
  (let ((mag (-> self control cpad stick0-speed))
        (deadzone (-> *pc-settings* stick-deadzone)))

    ;; apply deadzone
    (when (< mag deadzone)
      (set! mag 0.0))

    ;; apply movement scaling
    (set! (-> self control pad-stick-speed)
          (* (min mag 1.0)
            (movement-speed-multiplier))))

  ;; finally, apply world transform
  (vector-matrix*! arg0 arg0 (matrix-local->world #t #f)))

(defbehavior force-forward-input target ((arg0 vector))
  ;; frame sync like normal input
  (when (!= (-> self control pad-read-time)
             (-> *display* real-frame-counter))
    (set! (-> self control last-stick-vec quad)
          (-> self control stick-vec quad))
    (set! (-> self control last-pad-stick-speed)
          (-> self control pad-stick-speed))
    (set! (-> self control pad-read-time)
          (the-as uint (-> *display* real-frame-counter))))

  ;; force local forward
  (set! (-> arg0 x) 0.0)
  (set! (-> arg0 y) 0.0)
  (set! (-> arg0 z) 1.0)
  (set! (-> arg0 w) 0.0)

  ;; store vector
  (set! (-> self control stick-vec quad)
        (-> arg0 quad))

  ;; force full movement speed
  (set! (-> self control pad-stick-speed)
        (movement-speed-multiplier))

  ;; transform into world space
  (vector-matrix*! arg0 arg0 (matrix-local->world #t #f)))

(defun get-camera-pitch ()
  (-> (the-as camera-slave (-> *camera* slave 0))
      tracking inv-mat vector 0 w))
