(in-package goal)
(require "engine/mods/hl-weapons.gc")
(require "engine/mods/hl-inputs-handler.gc")

(defconstant pistol-attack-cooldown (seconds 0.3))
(defconstant pistol-second-attack-cooldown  (seconds 0.22))
(defconstant pistol-draw-duration (seconds 0.8))
(defconstant pistol-reload-part1-duration (seconds 1.2))
(defconstant pistol-reload-part2-duration (seconds 1.1))
(defconstant pistol-idle1-duration (seconds 3.75))
(defconstant pistol-idle2-duration (seconds 2.5))
(defconstant pistol-idle3-duration (seconds 3.06))
(defconstant pistol-aim-punch-decay 0.1)
(defconstant pistol-aim-punch-amount 0.05)
(defconstant debug-hit-detection #f)
(defconstant pistol-damage 20)

(defbehavior pistol-switch-handle hl-weapons ()
  ;; Crowbar
  (when (and (should-switch-slot1?)
             (time-elapsed? (-> self weapon-last-switch-time) weapon-switch-cooldown)
             (not (= (-> self current-weapon) (weapons-enum crowbar))))
    (set-time! (-> self weapon-last-switch-time))
    (set! (-> self last-weapon) (weapons-enum pistol))
    (go crowbar-draw))
  ;; Revolver
  (when (and (should-switch-slot2?)
             (time-elapsed? (-> self weapon-last-switch-time) weapon-switch-cooldown)
             (not (= (-> self current-weapon) (weapons-enum revolver)))
             (check-weapon-owned (owned-weapons revolver)))
    (set-time! (-> self weapon-last-switch-time))
    (set! (-> self last-weapon) (weapons-enum pistol))
    (go revolver-draw))
  ;; SMG or Shotgun
  (when (and (should-switch-slot3?)
             (time-elapsed? (-> self weapon-last-switch-time) weapon-switch-cooldown))
    (set-time! (-> self weapon-last-switch-time))

    (if (and (check-weapon-owned (owned-weapons smg)) (not (= (-> self current-weapon) (weapons-enum smg))))
      (begin (set! (-> self last-weapon) (weapons-enum pistol)) (go smg-draw))
      (begin (when (and (check-weapon-owned (owned-weapons shotgun)) (not (= (-> self current-weapon) (weapons-enum shotgun))))
          (set! (-> self last-weapon) (weapons-enum pistol))
          (go shotgun-draw))
      )
    )
  )
  ;; Gauss
  (when (and (should-switch-slot4?)
             (time-elapsed? (-> self weapon-last-switch-time) weapon-switch-cooldown)
             (not (= (-> self current-weapon) (weapons-enum gauss)))
             (check-weapon-owned (owned-weapons gauss)))
    (set-time! (-> self weapon-last-switch-time))
    (set! (-> self last-weapon) (weapons-enum pistol))
    (go gauss-draw))

  (when (and (should-switch-last-weapon?)
             (time-elapsed? (-> self weapon-last-switch-time) weapon-switch-cooldown)
             (not (= (-> self current-weapon) (-> self last-weapon))))
    (set-time! (-> self weapon-last-switch-time))
    (case (-> self last-weapon)
      (((weapons-enum crowbar))
        (set! (-> self last-weapon) (weapons-enum pistol))
        (go crowbar-draw))
      (((weapons-enum revolver))
        (when (check-weapon-owned (owned-weapons revolver))
          (set! (-> self last-weapon) (weapons-enum pistol))
          (go revolver-draw))
      )
      (((weapons-enum shotgun))
        (when (check-weapon-owned (owned-weapons shotgun))
          (set! (-> self last-weapon) (weapons-enum pistol))
          (go shotgun-draw))
      )
      (((weapons-enum smg))
        (when (check-weapon-owned (owned-weapons smg))
          (set! (-> self last-weapon) (weapons-enum pistol))
          (go smg-draw))
      )
      (((weapons-enum gauss))
        (when (check-weapon-owned (owned-weapons gauss))
          (set! (-> self last-weapon) (weapons-enum pistol))
          (go gauss-draw))
      ))))

(defbehavior do-pistol-reload hl-weapons ()
 (when (and (should-reload?) (!= (-> self current-pistol-mag-ammo) pistol-max-mag-ammo) (or (> (-> self current-9mm-ammo) 0) (-> *pc-settings* unlimited-ammo?)))
  (go pistol-reload-part1)))

(defstate pistol-holster (hl-weapons)
  :event hl-weapons-standard-event-handler
  :enter
  (behavior ()
    (viewmodel-play-animation (viewmodel-animations-enum holster) 2.0))
  :code
  (behavior ()
    (loop (suspend)))
  :post
  (behavior ()
    (hl-weapons-common-post)
    (update-aim-punch 0.1)))

(defstate pistol-draw (hl-weapons)
  :event hl-weapons-standard-event-handler
  :enter
  (behavior ()
    (hl-set-weapon (weapons-enum pistol))
    (viewmodel-play-animation (viewmodel-animations-enum draw) 0.6)
    (hl-choose-idle-wait! 0.0 0.0)
    (set-time! (-> self weapon-last-switch-time))
    (set-time! (-> self weapon-last-reload-time))
    (set-time! (-> self weapon-last-attack-time)))
  
  :trans
  (behavior ()
    (when (time-elapsed? (-> self weapon-last-attack-time) pistol-draw-duration)
        (go pistol-idle))
    (pistol-switch-handle))
  
  :code
  (behavior ()
    (loop (suspend)))
  :post
  (behavior ()
    (hl-weapons-common-post)
    (when debug-hit-detection
      (fire-hl-shot *target* #t 0.0 0.0 pistol-damage))
    (update-aim-punch pistol-aim-punch-decay)))

(defstate pistol-idle (hl-weapons)
  :event hl-weapons-standard-event-handler
  :enter
  (behavior ()
    (when (= (-> self weapon-next-idle-wait) 0)
      (hl-choose-idle-wait! 1.5 1.5)))
  :trans
  (behavior ()
    (pistol-switch-handle)

    (when (and (should-attack?)
               (time-elapsed? (-> self weapon-last-attack-time) pistol-attack-cooldown))
      (go pistol-attack))
    (when (and (should-second-attack?)
               (time-elapsed? (-> self weapon-last-attack-time) pistol-second-attack-cooldown))
      (go pistol-attack-secondary))
    (do-pistol-reload)
    (when (and (= (-> self current-pistol-mag-ammo) 0) (or (> (-> self current-9mm-ammo) 0) (-> *pc-settings* unlimited-ammo?)) (not (paused?)) (not (should-attack?)))
      (go pistol-reload-part1))
    (when (time-elapsed? (-> self weapon-last-idle-time) (-> self weapon-next-idle-wait))
      (go pistol-idle-anim)))
  :code
  (behavior ()
    (loop (suspend)))

  :post
  (behavior ()
    (hl-weapons-common-post)
    (when debug-hit-detection
      (fire-hl-shot *target* #t 0.0 0.0 pistol-damage))
    (update-aim-punch pistol-aim-punch-decay)
    ))


(defstate pistol-idle-anim (hl-weapons)
  :event hl-weapons-standard-event-handler
  :enter
  (behavior ()
    (let ((idx (rand-vu-int-range 0 2)))
      (case idx
        ((0)
         (viewmodel-play-animation (viewmodel-animations-enum pistol-idle3) 1.0)
         (set! (-> self weapon-next-idle-wait) pistol-idle3-duration))
        ((1)
         (viewmodel-play-animation (viewmodel-animations-enum pistol-idle1) 1.0)
         (set! (-> self weapon-next-idle-wait) pistol-idle1-duration))
        ((2)
         (viewmodel-play-animation (viewmodel-animations-enum pistol-idle2) 1.0)
         (set! (-> self weapon-next-idle-wait) pistol-idle2-duration)))
      (set-time! (-> self weapon-last-idle-time))))
  :trans
  (behavior ()
    (pistol-switch-handle)
    (when (time-elapsed? (-> self weapon-last-idle-time) (-> self weapon-next-idle-wait))
      (go pistol-idle))
    (when (and (should-attack?)
               (time-elapsed? (-> self weapon-last-attack-time) pistol-attack-cooldown))
      (go pistol-attack))
    (when (and (should-second-attack?)
               (time-elapsed? (-> self weapon-last-attack-time) pistol-second-attack-cooldown))
      (go pistol-attack-secondary))
      (do-pistol-reload))
  :code
  (behavior ()
    (loop (suspend)))
  :post
  (behavior ()
    (hl-weapons-common-post)
    (when debug-hit-detection
      (fire-hl-shot *target* #t 0.0 0.0 pistol-damage))
    (update-aim-punch pistol-aim-punch-decay)
    ))

(defstate pistol-attack (hl-weapons)
  :event hl-weapons-standard-event-handler
  :enter
  (behavior ()
    (when (or (> (-> self current-pistol-mag-ammo) 0) (target-has-eco-type? (pickup-type eco-yellow)))
      ;; In fish we have unlimited pistol ammo
      (unless (or (= (-> *target* state name) 'target-hl-fishing) (target-has-eco-type? (pickup-type eco-yellow)))
        (-! (-> self current-pistol-mag-ammo) 1))
      (let ((spread-x (rand-vu-float-range 0.0 0.001))
            (spread-y (rand-vu-float-range 0.0 0.001)))
        (fire-hl-shot *target* #f spread-x spread-y pistol-damage))
      (viewmodel-play-animation (viewmodel-animations-enum pistol-shoot) 1.0)
      (add-aim-punch pistol-aim-punch-amount)
      (play-mod-sound "pl_gun3")
      (hl-choose-idle-wait! 5.0 15.0)
      (when (and (!= (-> *target* state name) 'target-hl-fishing) (not (target-has-eco-type? (pickup-type eco-yellow))) (<= (-> self current-pistol-mag-ammo) 0) (<= (-> self current-9mm-ammo) 0) (-> *pc-settings* hev-sounds?) (not (-> *pc-settings* unlimited-ammo?)))
        (play-mod-sound "ammo_depleted"))
    )
    (set-time! (-> self weapon-last-attack-time)))
  :trans
  (behavior ()
    (pistol-switch-handle)
    (when (time-elapsed? (-> self weapon-last-attack-time) pistol-attack-cooldown)
      (go pistol-idle))
    (when (time-elapsed? (-> self weapon-last-attack-time) pistol-second-attack-cooldown)
      (go pistol-idle)))
  
  :code
  (behavior ()
    (loop (suspend)))

  :post
  (behavior ()
    (hl-weapons-common-post)
    (when debug-hit-detection
      (fire-hl-shot *target* #t 0.0 0.0 pistol-damage))
    (update-aim-punch pistol-aim-punch-decay)
    ))

(defstate pistol-attack-secondary (hl-weapons)
  :event hl-weapons-standard-event-handler
  :enter
  (behavior ()
    (when (or (> (-> self current-pistol-mag-ammo) 0) (target-has-eco-type? (pickup-type eco-yellow)))
      (unless (or (= (-> *target* state name) 'target-hl-fishing) (target-has-eco-type? (pickup-type eco-yellow)))
        (-! (-> self current-pistol-mag-ammo) 1))
      (let ((spread-x (rand-vu-float-range -0.1 0.1))
            (spread-y (rand-vu-float-range -0.1 0.1)))
        (fire-hl-shot *target* #f spread-x spread-y pistol-damage))
      (viewmodel-play-animation (viewmodel-animations-enum pistol-shoot) 1.0)
      (add-aim-punch pistol-aim-punch-amount)
      (play-mod-sound "pl_gun3")
      (hl-choose-idle-wait! 5.0 15.0)
      (when (and (!= (-> *target* state name) 'target-hl-fishing) (not (target-has-eco-type? (pickup-type eco-yellow))) (<= (-> self current-pistol-mag-ammo) 0) (<= (-> self current-9mm-ammo) 0) (-> *pc-settings* hev-sounds?) (not (-> *pc-settings* unlimited-ammo?)))
        (play-mod-sound "ammo_depleted"))
      )
    (set-time! (-> self weapon-last-attack-time)))
  :trans
  (behavior ()
    (pistol-switch-handle)
    (when (time-elapsed? (-> self weapon-last-attack-time) pistol-attack-cooldown)
      (go pistol-idle))
    (when (time-elapsed? (-> self weapon-last-attack-time) pistol-second-attack-cooldown)
      (go pistol-idle)))
  
  :code
  (behavior ()
    (loop (suspend)))

  :post
  (behavior ()
    (hl-weapons-common-post)
    (when debug-hit-detection
      (fire-hl-shot *target* #t 0.0 0.0 pistol-damage))
    (update-aim-punch pistol-aim-punch-decay)
    ))

(defstate pistol-reload-part1 (hl-weapons)
  :event hl-weapons-standard-event-handler
  :enter
  (behavior ()
    (viewmodel-play-animation (viewmodel-animations-enum pistol-reload) 1.0)
    (play-mod-sound "9mmclip2")
    (set-time! (-> self weapon-last-reload-time)))
  
  :trans
  (behavior ()
    (pistol-switch-handle)
    ;; transition to part2 after mag out finished
    (when (time-elapsed? (-> self weapon-last-reload-time) pistol-reload-part1-duration)
      (go pistol-reload-part2)))
  :code
  (behavior ()
    (loop (suspend)))
  :post
  (behavior ()
    (hl-weapons-common-post)
    (when debug-hit-detection
      (fire-hl-shot *target* #t 0.0 0.0 pistol-damage))
    (update-aim-punch pistol-aim-punch-decay)
    ))

(defstate pistol-reload-part2 (hl-weapons)
  :event hl-weapons-standard-event-handler
  :enter
  (behavior ()
    (if (-> *pc-settings* unlimited-ammo?)
      (begin
        (set! (-> self current-pistol-mag-ammo) pistol-max-mag-ammo)
      )

      (begin
        (let ((missing (- pistol-max-mag-ammo
                          (-> self current-pistol-mag-ammo)))
              (reserve (-> self current-9mm-ammo)))

          (let ((to-load (min missing reserve)))
            (set! (-> self current-pistol-mag-ammo)
                  (+ (-> self current-pistol-mag-ammo)
                    to-load))

            (set! (-> self current-9mm-ammo)
                  (- reserve to-load)))))
    )

    (play-mod-sound "9mmclip1")
    (set-time! (-> self weapon-last-reload-time)))
  :trans
  (behavior ()
    (pistol-switch-handle)
    (when (time-elapsed? (-> self weapon-last-reload-time) pistol-reload-part2-duration)
      (go pistol-idle))
    (when (should-attack?)
      (go pistol-attack)))
  
  :code
  (behavior ()
    (loop (suspend)))
  :post
  (behavior ()
    (hl-weapons-common-post)
    (when debug-hit-detection
      (fire-hl-shot *target* #t 0.0 0.0 pistol-damage))
    (update-aim-punch pistol-aim-punch-decay)
    ))
