(in-package goal)
(require "engine/mods/hl-inputs-handler.gc")

(define-extern kill-hl-weapons-collectable (function none))
(define-extern spawn-hl-weapons-collectable (function none))

(defenum weapons-enum
  :type uint16
  (crowbar 0)
  (pistol 1)
  (smg 2)
  (gauss 3)
  (revolver 4)
  (shotgun 5))

(defenum ammo-type
  :type uint16
  (smg-grenade 0)
  (pistol 1)
  (gauss 2)
  (revolver 3)
  (shotgun 4))

(defenum owned-weapons
  :type uint8
  :bitfield #t
  (pistol 0)
  (smg 1)
  (revolver 2)
  (shotgun 3)
  (gauss 4)
)

(defenum viewmodel-animations-enum
  :type uint16
  (draw 0)
  ;; crowbar
  (crowbar-attack1 1)
  (crowbar-attack1-miss 2)
  (crowbar-attack2 3)
  (crowbar-attack2-hit 4)
  (crowbar-attack3 5)
  (crowbar-attack3-hit 6)
  ;; pistol
  (pistol-idle1 7)
  (pistol-idle2 8)
  (pistol-idle3 9)
  (pistol-shoot 10)
  (pistol-shoot-empty 11)
  (pistol-reload 12)
  (pistol-reload-noshot 13)
  ;; smg
  (smg-idle1 14)
  (smg-longidle 15)
  (smg-shoot 16)
  (smg-shoot2 17)
  (smg-shoot3 18)
  (smg-reload 19)
  (smg-grenade 20)
  ;; gauss
  (gauss-fidget 21)
  (gauss-fire 22)
  (gauss-fire2 23)
  (gauss-idle1 24)
  (gauss-idle2 25)
  (gauss-spin 26)
  (gauss-spinup 27)
  ;; Holster
  (holster 28)
  ;; Revolver
  (revolver-fidget 29)
  (revolver-fire 30)
  (revolver-idle1 31)
  (revolver-idle2 32)
  (revolver-idle3 33)
  (revolver-reload 34)
  ;; Shotgun
  (shotgun-start-reload 35)
  (shotgun-shoot-big 36)
  (shotgun-shoot 37)
  (shotgun-reload 38)
  (shotgun-reholster 39)
  (shotgun-pump 40)
  (shotgun-idle4 41)
  (shotgun-deepidle 42))

(deftype hl-weapons (process-drawable)
  ((current-weapon                 weapons-enum)
   (last-weapon                    weapons-enum)
   (last-hit-pat-mode              pat-mode)
   (last-hit-pat-material          pat-material)
   (weapon-last-attack-time        time-frame)
   (weapon-last-second-attack-time time-frame)
   (weapon-last-switch-time        time-frame)
   (weapon-last-reload-time        time-frame)
   (weapon-last-idle-time          time-frame)
   (weapon-next-idle-wait          time-frame)
   (current-aim-punch-last-update  time-frame)
   (crowbar-swing-index            uint16)
   ;; Mag ammo
   (current-pistol-mag-ammo        uint16)
   (current-smg-mag-ammo           uint16)
   (current-gauss-mag-ammo         uint16)
   (current-revolver-mag-ammo      uint16)
   (current-shotgun-mag-ammo       uint16)
   ;; Reserve ammo
   (current-smg-grenade-ammo       uint16)
   (current-9mm-ammo               uint16)
   (current-revolver-ammo          uint16)
   (current-shotgun-ammo           uint16)
   (gauss-recharge-time            time-frame)
   (last-gauss-attack-time         time-frame)
   (owned-weapons                  owned-weapons))
  (:methods)
  (:states
    ;; crowbar
    crowbar-holster
    crowbar-draw
    crowbar-idle
    crowbar-attack-miss
    crowbar-attack-hit
    ;; pistol
    pistol-holster
    pistol-draw
    pistol-idle
    pistol-idle-anim
    pistol-attack
    pistol-attack-secondary
    pistol-reload-part1
    pistol-reload-part2
    ;; smg
    smg-holster
    smg-draw
    smg-idle
    smg-idle-anim
    smg-attack
    smg-reload-part1
    smg-reload-part2
    smg-secondary
    ;; gauss
    gauss-holster
    gauss-draw
    gauss-idle
    gauss-attack
    gauss-attack-secondary
    gauss-attack-secondary-charge
    gauss-after-attack
    gauss-after-attack-overcharge
    ;; revolver
    revolver-holster
    revolver-draw
    revolver-idle
    revolver-idle-anim
    revolver-attack
    revolver-reload-part1
    revolver-reload-part2
    ;; shotgun
    shotgun-holster
    shotgun-draw
    shotgun-idle
    shotgun-idle-anim
    shotgun-attack
    shotgun-attack-secondary
    shotgun-start-reload
    shotgun-reload
    shotgun-reload-pump))

(define-perm *hl-weapons* hl-weapons #f)

(defconstant weapon-switch-cooldown (seconds 0.05))
(defconstant pistol-max-mag-ammo 17)
(defconstant smg-max-mag-ammo 50)
(defconstant gauss-max-mag-ammo 100)
(defconstant revolver-max-mag-ammo 6)
(defconstant shotgun-max-mag-ammo 8)

(defconstant 9mm-max-ammo 250)
(defconstant smg-grenade-max-ammo 10)
(defconstant revolver-max-ammo 36)
(defconstant shotgun-max-ammo 125)

(defbehavior init-hl-weapons hl-weapons ()
  (stack-size-set! (-> self main-thread) 1024)
  (set-time! (-> self weapon-last-attack-time))
  (set! (-> self current-pistol-mag-ammo) pistol-max-mag-ammo)
  (set! (-> self current-smg-mag-ammo) smg-max-mag-ammo)
  (set! (-> self current-gauss-mag-ammo) 50)
  (set! (-> self current-revolver-mag-ammo) revolver-max-mag-ammo)
  (set! (-> self current-shotgun-mag-ammo) shotgun-max-mag-ammo)
  (set! (-> self last-weapon) (weapons-enum crowbar))

  (set! (-> self current-9mm-ammo) (-> *game-info* 9mm-ammo))
  (set! (-> self current-smg-grenade-ammo) (-> *game-info* smg-grenade-ammo))
  (set! (-> self current-revolver-ammo) (-> *game-info* revolver-ammo))
  (set! (-> self current-shotgun-ammo) (-> *game-info* shotgun-ammo))

  (logclear! (-> self owned-weapons) (owned-weapons pistol))
  (logclear! (-> self owned-weapons) (owned-weapons smg))
  (logclear! (-> self owned-weapons) (owned-weapons revolver))
  (logclear! (-> self owned-weapons) (owned-weapons shotgun))
  (logclear! (-> self owned-weapons) (owned-weapons gauss))
  (format 0 "HL Weapons process initialized.~%")
  (go crowbar-draw))

(defun start-hl-weapons ()
  (let ((v1-3 (process-spawn hl-weapons :init init-hl-weapons :from *4k-dead-pool* :to *active-pool* :stack *kernel-dram-stack* :stack-size #x4000 :name 'hl-weapon-proc)))
    (format 0 "STARTED WEAPONS PROCESS~%")
    (if v1-3 (set! *hl-weapons* (the-as hl-weapons (-> v1-3 0 self))) (set! *hl-weapons* #f)))
  (none))

(defun reset-hl-weapon-stuff ()
  (set! (-> *hl-weapons* weapon-last-switch-time) 0)
  (set! (-> *hl-weapons* weapon-last-attack-time) 0)
  (set! (-> *hl-weapons* weapon-last-second-attack-time) 0)
  (set! (-> *hl-weapons* weapon-last-reload-time) 0)
  (set! (-> *hl-weapons* weapon-last-idle-time) 0)
  (set! (-> *hl-weapons* gauss-recharge-time) 0)
  (set! (-> *hl-weapons* last-gauss-attack-time) 0)
  (when (-> *pc-settings* unlimited-ammo?)
    (set! (-> *hl-weapons* current-pistol-mag-ammo) pistol-max-mag-ammo)
    (set! (-> *hl-weapons* current-smg-mag-ammo) smg-max-mag-ammo)
    (set! (-> *hl-weapons* current-gauss-mag-ammo) gauss-max-mag-ammo)
    (set! (-> *hl-weapons* current-revolver-mag-ammo) revolver-max-mag-ammo)
    (set! (-> *hl-weapons* current-shotgun-mag-ammo) shotgun-max-mag-ammo))
  )

(defun viewmodel-play-animation ((animation viewmodel-animations-enum) (anim-speed float))
  (pc-set-viewmodel-animation-speed anim-speed)
  (pc-set-viewmodel-active-animation (the-as int animation)))

(defbehavior hl-set-crosshair hl-weapons ((weapon weapons-enum))
  (pc-set-crosshair-current-crosshair (the-as int weapon)))

(defbehavior hl-set-weapon hl-weapons ((weapon weapons-enum))
  (set! (-> self current-weapon) weapon)
  (pc-set-viewmodel-active-model (the-as int weapon))
  (hl-set-crosshair weapon))

(defbehavior hl-weapons-standard-event-handler hl-weapons ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('change-mode)
     (case (-> arg3 param 0)
       (('fishing) 
        (when (!= (-> self current-weapon) (weapons-enum pistol))
          (set! (-> *hl-weapons* current-pistol-mag-ammo) pistol-max-mag-ammo)
          (go pistol-draw)))))
    (('go-idle)
     (case (-> self current-weapon)
       (((weapons-enum gauss))
          (go gauss-idle))
       (((weapons-enum shotgun))
          (go shotgun-idle))
          ))
    (('go-draw-crowbar)
      (go crowbar-draw))
    (('go-draw)
     (case (-> self current-weapon)
       (((weapons-enum crowbar))
          (go crowbar-draw))
       (((weapons-enum pistol))
          (go pistol-draw))
       (((weapons-enum revolver))
          (go revolver-draw))
       (((weapons-enum shotgun))
          (go shotgun-draw))
       (((weapons-enum smg))
          (go smg-draw))
       (((weapons-enum gauss))
          (go gauss-draw))
        ))
    (('edge-grab)
     (case (-> self current-weapon)
       (((weapons-enum crowbar))
          (go crowbar-holster))
       (((weapons-enum pistol))
          (go pistol-holster))
       (((weapons-enum revolver))
          (go revolver-holster))
       (((weapons-enum shotgun))
          (go shotgun-holster))
       (((weapons-enum smg))
          (go smg-holster))
       (((weapons-enum gauss))
          (go gauss-holster))))
    (('pickup-smg-grenade)
      (when (< (-> self current-smg-grenade-ammo) smg-grenade-max-ammo)
        (set! (-> self current-smg-grenade-ammo)
              (min smg-grenade-max-ammo
                  (+ (-> self current-smg-grenade-ammo)
                      2)))))
    (('pickup-gauss-ammo)
      (when (< (-> self current-gauss-mag-ammo) gauss-max-mag-ammo)
        (set! (-> self current-gauss-mag-ammo)
              (min gauss-max-mag-ammo
                  (+ (-> self current-gauss-mag-ammo)
                      20)))))
    (('pickup-9mm-ammo)
      (when (< (-> self current-9mm-ammo) 9mm-max-ammo)
        (set! (-> self current-9mm-ammo)
              (min 9mm-max-ammo
                  (+ (-> self current-9mm-ammo)
                      20)))))
    (('pickup-revolver-ammo)
      (when (< (-> self current-revolver-ammo) revolver-max-ammo)
        (set! (-> self current-revolver-ammo)
              (min revolver-max-ammo
                  (+ (-> self current-revolver-ammo)
                      6)))))
    (('pickup-shotgun-ammo)
      (when (< (-> self current-shotgun-ammo) shotgun-max-ammo)
        (set! (-> self current-shotgun-ammo)
              (min shotgun-max-ammo
                  (+ (-> self current-shotgun-ammo)
                      12)))))
    (('pickup-pistol)
      (set! (-> self last-weapon) (-> self current-weapon))
      (logior! (-> self owned-weapons) (owned-weapons pistol))
      (go pistol-draw))
    (('pickup-smg)
      (set! (-> self last-weapon) (-> self current-weapon))
      (logior! (-> self owned-weapons) (owned-weapons smg))
      (go smg-draw))
    (('pickup-revolver)
      (set! (-> self last-weapon) (-> self current-weapon))
      (logior! (-> self owned-weapons) (owned-weapons revolver))
      (go revolver-draw))
    (('pickup-shotgun)
      (set! (-> self last-weapon) (-> self current-weapon))
      (logior! (-> self owned-weapons) (owned-weapons shotgun))
      (go shotgun-draw))
    (('pickup-gauss)
      (set! (-> self last-weapon) (-> self current-weapon))
      (logior! (-> self owned-weapons) (owned-weapons gauss))
      (go gauss-draw))
))

(defbehavior change-weapon-fishgame hl-weapons ()
  (when (and (= (-> *target* state name) 'target-hl-fishing) (!= (-> self current-weapon) (weapons-enum pistol)))
    (go pistol-draw)))

(defbehavior hl-choose-idle-wait! hl-weapons ((min-secs float) (max-secs float))
  (let ((rand-secs (rand-vu-float-range min-secs max-secs)))
    (set! (-> self weapon-next-idle-wait) (the-as time-frame (seconds rand-secs)))
    (set-time! (-> self weapon-last-idle-time))))

(defun set-camera-pitch ((new-pitch float))
  (set! (-> (the-as camera-slave (-> *camera* slave 0)) tracking inv-mat vector 0 w) new-pitch))

(defbehavior add-aim-punch hl-weapons ((amount float))
  (set! *current-aim-punch* (+ *current-aim-punch* amount))
  (set! *current-aim-punch-offset* (+ *current-aim-punch-offset* amount)))

;; decay punch over time
(defbehavior update-aim-punch hl-weapons ((decay-rate float))
  (when (> (abs *current-aim-punch-offset*) 0.0001)
    (let ((decay (* *current-aim-punch-offset* decay-rate)))
      (when (> (abs decay) (abs *current-aim-punch-offset*))
        (set! decay *current-aim-punch-offset*))
      (set! *current-aim-punch* (- *current-aim-punch* decay 0.000045))
      (set! *current-aim-punch-offset* (- *current-aim-punch-offset* decay)))))

;; Gauss ammo starts recharging each 0.2 seconds, 2.0 seconds after the last attack
(defbehavior recharge-gauss-ammo hl-weapons ()
  (when (and (time-elapsed? (-> self last-gauss-attack-time) (seconds 2.0)) (time-elapsed? (-> self gauss-recharge-time) (seconds 0.2)) (< (-> self current-gauss-mag-ammo) 100))
    (+! (-> self current-gauss-mag-ammo) 1)
    (set-time! (-> self gauss-recharge-time))))

(defbehavior hl-weapons-common-post hl-weapons ()
  (when (-> *pc-settings* unlimited-ammo?)
    (recharge-gauss-ammo))
  (none)
)

(defun fire-hl-shot ((shooter process-drawable) (is-debug? symbol) (offset-x float) (offset-y float) (damage int))
  (rlet ((vf0 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf))
    (init-vf0-vector)

    (let ((max-dist (meters 1000))
          (backoff-epsilon (the-as float 10.0))
          (probe-radius 1.0))
      (let* ((cam-pos (camera-pos))
             (cam-forward (vector-float*! (new 'stack-no-clear 'vector)
                                          (-> *math-camera* inv-camera-rot vector 2)
                                          1.0))
             (cam-right   (-> *math-camera* inv-camera-rot vector 0))
             (cam-up      (-> *math-camera* inv-camera-rot vector 1))
             (spread-dir (new 'stack-no-clear 'vector))
             (probe-move (new 'stack-no-clear 'vector))
             (probe-res (new 'stack-no-clear 'collide-tri-result))
             (probe-pat (new 'static 'pat-surface :noentity #x1))
             (spawn-pos (new 'stack-no-clear 'vector)))

        (vector-! spread-dir cam-forward
                  (vector-float*! (new 'stack-no-clear 'vector) cam-right offset-x))
        (vector+! spread-dir spread-dir
                  (vector-float*! (new 'stack-no-clear 'vector) cam-up offset-y))

        (vector-float*! probe-move spread-dir max-dist)

        (when (>= (fill-and-probe-using-line-sphere
                    *collide-cache*
                    cam-pos
                    probe-move
                    probe-radius
                    (collide-kind
                      water
                      background
                      crate
                      cak-1
                      cak-2 
                      cak-3 
                      enemy 
                      wall-object
                      ground-object
                      target-attack
                      mother-spider
                      cak-14
                      blue-eco-suck
                      unknown-16
                      unknown-17
                      unknown-18
                      unknown-19
                      unknown-20
                      unknown-21
                      unknown-22
                      unknown-23
                      unknown-24
                      unknown-25
                      unknown-26
                      unknown-27
                      unknown-28
                      unknown-29
                      unknown-30
                      unknown-31
                      unknown-32
                      unknown-33
                      unknown-34
                      unknown-35
                      unknown-36
                      unknown-37
                      unknown-38
                      unknown-39
                      unknown-40
                      unknown-41
                      unknown-42
                      unknown-43
                      unknown-44
                      unknown-45
                      unknown-46
                      unknown-47
                      unknown-48
                      unknown-49
                      unknown-50
                      unknown-51
                      unknown-52
                      unknown-53
                      unknown-54
                      unknown-55
                      unknown-56
                      unknown-57
                      unknown-58
                      unknown-59
                      unknown-60
                      unknown-61
                      unknown-62
                      unknown-63
                    )
                    (the-as process #f)
                    probe-res
                    probe-pat)
                  0.0)

          (let ((hit-pos (the-as vector (-> probe-res intersect))) (hit-pat (-> probe-res pat)) (hit-mat (-> probe-res pat material)))
            (vector-! spawn-pos hit-pos
                      (vector-float*! (new 'stack-no-clear 'vector) cam-forward backoff-epsilon))
            (set! (-> *hl-weapons* last-hit-pat-mode) (-> hit-pat mode))
            (set! (-> *hl-weapons* last-hit-pat-material) hit-mat)

            (when (not is-debug?)
              (let ((s4-0 (get-process *default-dead-pool* hl-weapon-shot #x4000)))
                (when s4-0
                  (let ((t9-2 (method-of-type hl-weapon-shot activate)))
                    (t9-2 (the-as hl-weapon-shot s4-0) shooter 'hl-weapon-shot (the-as pointer #x70004000)))
                  (let ((s3-0 run-function-in-process)
                        (s2-0 s4-0)
                        (s1-0 projectile-hl-init-by-other)
                        (s0-0 (-> shooter entity))
                        (sv-48 spawn-pos)
                        (gp-1 (vector-float*! (new-stack-vector0)
                                              (-> *math-camera* inv-camera-rot vector 2)
                                              (the-as float (meters 0.5))))
                        (t2-0 #f))
                    ((the-as (function object object object object object object object object none) s3-0)
                    s2-0 s1-0 s0-0 sv-48 gp-1 (part-type-enum common-shot) t2-0 damage))
                  (-> s4-0 ppointer))))
                  (if is-debug? (add-debug-sphere #t (bucket-id debug) hit-pos (meters 0.5) *color-white*))))))))

