  (spawn-hl-weapons-collectable)
  (none)
)

(defun start-weapons-beach-il ()
  (set! (-> *hl-weapons* current-pistol-mag-ammo) pistol-max-mag-ammo)
  (set! (-> *hl-weapons* current-smg-mag-ammo) smg-max-mag-ammo)
  (set! (-> *hl-weapons* current-gauss-mag-ammo) gauss-max-mag-ammo)
  (set! (-> *hl-weapons* current-revolver-mag-ammo) revolver-max-mag-ammo)
  (set! (-> *hl-weapons* current-shotgun-mag-ammo) shotgun-max-mag-ammo)
  (set! (-> *hl-weapons* last-weapon) (weapons-enum crowbar))

  (set! (-> *hl-weapons* current-9mm-ammo) 9mm-max-ammo)
  (set! (-> *hl-weapons* current-smg-grenade-ammo) 0)
  (set! (-> *hl-weapons* current-revolver-ammo) revolver-max-ammo)
  (set! (-> *hl-weapons* current-shotgun-ammo) shotgun-max-ammo)

  (logior! (-> *hl-weapons* owned-weapons) (owned-weapons pistol))
  (logclear! (-> *hl-weapons* owned-weapons) (owned-weapons smg))
  (logior! (-> *hl-weapons* owned-weapons) (owned-weapons revolver))
  (logior! (-> *hl-weapons* owned-weapons) (owned-weapons shotgun))
  (logior! (-> *hl-weapons* owned-weapons) (owned-weapons gauss))
  (send-event *hl-weapons* 'go-draw-crowbar 0)
  (kill-hl-weapons-collectable)
  (spawn-hl-weapons-collectable)
  (none)
)

(defun hl-weapons-go-crowbar () 
  (send-event *hl-weapons* 'go-draw-crowbar 0)
  (none)
)

(defun handle-hl-all-weapons-toggle ()
  (if (-> *pc-settings* all-weapons?)
    (kill-hl-weapons-collectable)
    (spawn-hl-weapons-collectable))
    (none))