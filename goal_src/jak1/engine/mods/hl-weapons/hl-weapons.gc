  (logclear! (-> *hl-weapons* owned-weapons) (owned-weapons smg))
  (logclear! (-> *hl-weapons* owned-weapons) (owned-weapons revolver))
  (logclear! (-> *hl-weapons* owned-weapons) (owned-weapons shotgun))
  (logclear! (-> *hl-weapons* owned-weapons) (owned-weapons gauss))
  (send-event *hl-weapons* 'go-draw-crowbar 0)
