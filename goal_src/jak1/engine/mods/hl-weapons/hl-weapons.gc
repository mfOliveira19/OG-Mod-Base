(defun draw-speed ((buf dma-buffer))
  (when (and *target*
             (-> *target* control)
             (-> *target* control dynam))

    (let* ((vel  (-> *target* control transv))
           (grav (-> *target* control dynam gravity-normal))
           (yv   (vector-dot grav vel))
           (tmp  (new-stack-vector0)))

      (vector-! tmp vel (vector-float*! tmp grav yv))

      (draw-string-xy-scaled
        ;;(string-format "xzv: ~M (~M)" (vector-length tmp) (* (vector-length tmp) 25.8780))
        (string-format "xzv: ~M" (vector-length tmp))
        buf
        225
        212
        (the font-color 4)
        (font-flags shadow kerning)
        1.2))))

(defun hud-hl-display-on ()
  (when (and (not (process-by-name 'hl-hud-proc *active-pool*)) (process-by-name 'hl-weapon-proc *active-pool*))
    ;process-spawn-function, spawns a process that runs the function you give it
    (process-spawn-function process
      :name 'hl-hud-proc
      ;This lambda is our function
      (lambda :behavior process ()
        ;Code before the loop runs once on process spawn
        ;
        ;Loop runs once per frame while process is active
        (loop
          ;Start a bucket thing block so we can use draw functions
          (with-dma-buffer-add-bucket ((testbuf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf))
            (when (-> *pc-settings* show-speed?)
              (draw-speed testbuf))
            ;Other draw stuff
            (if (-> *pc-settings* unlimited-ammo?) (draw-ammo-unlimited-mode testbuf) (draw-ammo testbuf))
            
            )
          ;Processes should suspend themselves, the loop will resume next frame
          (suspend)))))
  ;Lisp returns the last form as the function return
  (none))

(defun hud-hl-display-off ()
  "Kill the hl hud process"
  (when (process-by-name 'hl-hud-proc *active-pool*)
    (kill-by-name 'hl-hud-proc *active-pool*))
  (none))

(defun fire-hl-grenade ((shooter process-drawable))
  (rlet ((vf0 :class vf))
    (init-vf0-vector)

    (let* ((spawn-forward-offset (the-as float (meters -0.0)))
           (grenade-speed (the-as float (meters 28.0)))
           (rotate (the-as float 0.0))
           (blast-radius (the-as float (meters 6.0)))

           ;; camera axes / pos
           (cam-pos (camera-pos))
           (cam-forward (-> *math-camera* inv-camera-rot vector 2))
           (cam-right   (-> *math-camera* inv-camera-rot vector 0))
           (cam-up      (-> *math-camera* inv-camera-rot vector 1))

           ;; temps
           (spawn-pos (new 'stack-no-clear 'vector))
           (vel       (new-stack-vector0))
           (tmp       (new 'stack-no-clear 'vector)))

      ;; spawn position = camera position + forward * spawn-forward-offset
      (vector-float*! tmp cam-forward spawn-forward-offset)
      (vector+! spawn-pos cam-pos tmp)

      ;; add height offset (move upward relative to camera)
      (let ((spawn-up-offset (the-as float (meters 0))))
        (vector-float*! tmp cam-up spawn-up-offset)
        (vector+! spawn-pos spawn-pos tmp))

      (vector-float*! vel cam-forward grenade-speed)

      (let ((forward cam-forward))
        (set! rotate (atan (-> forward x) (-> forward z))))
      (spawn-smg-grenade
        *entity-pool*
        spawn-pos
        vel
        rotate
        blast-radius
        (-> shooter entity))
        
        )))


(defun can-pickup-ammo? ((ammo-type ammo-type))
  (case ammo-type
    (((ammo-type smg-grenade))
      (if (< (-> *hl-weapons* current-smg-grenade-ammo) smg-grenade-max-ammo) #t #f))
    (((ammo-type pistol))
      (if (< (-> *hl-weapons* current-9mm-ammo) 9mm-max-ammo) #t #f))
    (((ammo-type shotgun))
      (if (< (-> *hl-weapons* current-shotgun-ammo) shotgun-max-ammo) #t #f))
    (((ammo-type revolver))
      (if (< (-> *hl-weapons* current-revolver-ammo) revolver-max-ammo) #t #f))
    (((ammo-type gauss))
      (if (< (-> *hl-weapons* current-gauss-mag-ammo) gauss-max-mag-ammo) #t #f))
    (else #f)
    )
)

(defun store-hl-weapons-status ()
  (when (not (-> *pc-settings* unlimited-ammo?))
    (set! (-> *game-info* smg-grenade-ammo) (the-as int (-> *hl-weapons* current-smg-grenade-ammo)))
    (set! (-> *game-info* 9mm-ammo) (the-as int (-> *hl-weapons* current-9mm-ammo)))
    (set! (-> *game-info* revolver-ammo) (the-as int (-> *hl-weapons* current-revolver-ammo)))
    (set! (-> *game-info* shotgun-ammo) (the-as int (-> *hl-weapons* current-shotgun-ammo)))
    (set! (-> *game-info* gauss-ammo) (the-as int (-> *hl-weapons* current-gauss-mag-ammo)))
    (set! (-> *game-info* pistol-mag-ammo) (the-as int (-> *hl-weapons* current-pistol-mag-ammo)))
    (set! (-> *game-info* revolver-mag-ammo) (the-as int (-> *hl-weapons* current-revolver-mag-ammo)))
    (set! (-> *game-info* smg-mag-ammo) (the-as int (-> *hl-weapons* current-smg-mag-ammo)))
    (set! (-> *game-info* shotgun-mag-ammo) (the-as int (-> *hl-weapons* current-shotgun-mag-ammo))))

  (set! (-> *game-info* current-weapon) (the-as int (-> *hl-weapons* current-weapon)))
  (set! (-> *game-info* last-weapon-used) (the-as int (-> *hl-weapons* last-weapon)))
  (set! (-> *game-info* owned-weapons) (the-as int (-> *hl-weapons* owned-weapons)))
  (none)
)

(defun load-hl-weapons-status ()
  (when (not (-> *pc-settings* unlimited-ammo?))
    (set! (-> *hl-weapons* current-smg-grenade-ammo) (-> *game-info* smg-grenade-ammo))
    (set! (-> *hl-weapons* current-9mm-ammo) (-> *game-info* 9mm-ammo))
    (set! (-> *hl-weapons* current-revolver-ammo) (-> *game-info* revolver-ammo))
    (set! (-> *hl-weapons* current-shotgun-ammo) (-> *game-info* shotgun-ammo))
    (set! (-> *hl-weapons* current-gauss-mag-ammo) (-> *game-info* gauss-ammo))
    (set! (-> *hl-weapons* current-pistol-mag-ammo) (-> *game-info* pistol-mag-ammo))
    (set! (-> *hl-weapons* current-revolver-mag-ammo) (-> *game-info* revolver-mag-ammo))
    (set! (-> *hl-weapons* current-smg-mag-ammo) (-> *game-info* smg-mag-ammo))
    (set! (-> *hl-weapons* current-shotgun-mag-ammo) (-> *game-info* shotgun-mag-ammo)))
  (set! (-> *hl-weapons* current-weapon) (the-as weapons-enum (-> *game-info* current-weapon)))
  (set! (-> *hl-weapons* last-weapon) (the-as weapons-enum (-> *game-info* last-weapon-used)))
  (set! (-> *hl-weapons* owned-weapons) (the-as owned-weapons (-> *game-info* owned-weapons)))
  (send-event *hl-weapons* 'go-draw 0)
  (none)
)

(defbehavior check-weapon-owned hl-weapons ((weapon owned-weapons))
  (or (logtest? (-> self owned-weapons) weapon) (-> *pc-settings* all-weapons?)))

(defun check-pistol-owned ()
  (or (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons pistol)) (-> *pc-settings* all-weapons?)))

(defun get-current-ammo ((ammo ammo-type))
  (case ammo
    ;; pistol ammo shared with smg
    (((ammo-type pistol)) (-> *hl-weapons* current-9mm-ammo))

    (((ammo-type smg-grenade)) (-> *hl-weapons* current-smg-grenade-ammo))

    (((ammo-type gauss)) (-> *hl-weapons* current-gauss-mag-ammo))

    (((ammo-type revolver)) (-> *hl-weapons* current-revolver-ammo))

    (((ammo-type shotgun)) (-> *hl-weapons* current-shotgun-ammo))

    (else 0))
)

(defun get-max-ammo ((ammo ammo-type))
  (case ammo
    ;; pistol ammo shared with smg
    (((ammo-type pistol)) 9mm-max-ammo)

    (((ammo-type smg-grenade)) smg-grenade-max-ammo)

    (((ammo-type gauss)) gauss-max-mag-ammo)

    (((ammo-type revolver)) revolver-max-ammo)

    (((ammo-type shotgun)) shotgun-max-ammo)

    (else 0))
)

(defun start-all-weapons-and-max-ammo ()
  (set! (-> *hl-weapons* current-pistol-mag-ammo) pistol-max-mag-ammo)
  (set! (-> *hl-weapons* current-smg-mag-ammo) smg-max-mag-ammo)
  (set! (-> *hl-weapons* current-gauss-mag-ammo) gauss-max-mag-ammo)
  (set! (-> *hl-weapons* current-revolver-mag-ammo) revolver-max-mag-ammo)
  (set! (-> *hl-weapons* current-shotgun-mag-ammo) shotgun-max-mag-ammo)
  (set! (-> *hl-weapons* last-weapon) (weapons-enum crowbar))

  (set! (-> *hl-weapons* current-9mm-ammo) 9mm-max-ammo)
  (set! (-> *hl-weapons* current-smg-grenade-ammo) smg-grenade-max-ammo)
  (set! (-> *hl-weapons* current-revolver-ammo) revolver-max-ammo)
  (set! (-> *hl-weapons* current-shotgun-ammo) shotgun-max-ammo)

  (logior! (-> *hl-weapons* owned-weapons) (owned-weapons pistol))
  (logior! (-> *hl-weapons* owned-weapons) (owned-weapons smg))
  (logior! (-> *hl-weapons* owned-weapons) (owned-weapons revolver))
  (logior! (-> *hl-weapons* owned-weapons) (owned-weapons shotgun))
  (logior! (-> *hl-weapons* owned-weapons) (owned-weapons gauss))
  (send-event *hl-weapons* 'go-draw-crowbar 0)
  (kill-hl-weapons-collectable)
  (none)
)

