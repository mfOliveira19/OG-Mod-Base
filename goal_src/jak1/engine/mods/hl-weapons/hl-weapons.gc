  (set! (-> *hl-weapons* current-9mm-ammo) 0)
  (set! (-> *hl-weapons* current-smg-grenade-ammo) 0)
  (set! (-> *hl-weapons* current-revolver-ammo) 0)
  (set! (-> *hl-weapons* current-shotgun-ammo) 0)

