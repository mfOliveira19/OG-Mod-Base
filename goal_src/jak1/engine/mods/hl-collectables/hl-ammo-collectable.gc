(in-package goal)

(define-extern can-pickup-ammo? (function ammo-type symbol))

(defconstant hl-hud-pickup-notice-base-pos 185)

(define *hl-hud-active-pickups* 0)

(defconstant hl-hud-slot-1 #b00000001)
(defconstant hl-hud-slot-2 #b00000010)
(defconstant hl-hud-slot-3 #b00000100)
(defconstant hl-hud-slot-4 #b00001000)
(defconstant hl-hud-slot-5 #b00010000)
(defconstant hl-hud-slot-6 #b00100000)
(defconstant hl-hud-slot-7 #b01000000)
(defconstant hl-hud-slot-8 #b10000000)

(define *hl-hud-slot-8-owner* #f)

(define *hl-hud-pickup-slots* 0)

(define *hl-hud-slot-8-generation* 0)

(defconstant hl-hud-pickup-notice-base-pos 185)
(defconstant hl-hud-pickup-notice-spacing 13)

(deftype hl-ammo-collectable (eco-collectable)
  ((ammo-type         ammo-type)
   (pickup-enter-time time-frame)
   (hud-slot int)
   (hud-generation int)
   (crate-id string)
   (wait-enter-time time-frame))
  (:methods
    (init-collision! (_type_) object)
    (send-ammo-pickup-event (_type_) none)
    (get-pickup-text (_type_ int) string)
    (get-pickup-amount (_type_) int)))

(def-art-elt smg-grenade-ammo-ag smg-grenade-ammo-lod0-jg 0)
(def-art-elt smg-grenade-ammo-ag smg-grenade-ammo-lod0-mg 1)
(def-art-elt smg-grenade-ammo-ag smg-grenade-ammo-idle-ja 2)

(defskelgroup *smg-grenade-ammo-sg* smg-grenade-ammo smg-grenade-ammo-lod0-jg smg-grenade-ammo-idle-ja
              ((smg-grenade-ammo-lod0-mg (meters 9999999)))
              :bounds (static-spherem 0 0 0 5))

(def-art-elt pistol-clip-ag pistol-clip-lod0-jg 0)
(def-art-elt pistol-clip-ag pistol-clip-lod0-mg 1)
(def-art-elt pistol-clip-ag pistol-clip-idle-ja 2)

(defskelgroup *pistol-clip-sg* pistol-clip pistol-clip-lod0-jg pistol-clip-idle-ja
              ((pistol-clip-lod0-mg (meters 9999999)))
              :bounds (static-spherem 0 0 0 5))

(def-art-elt shotgun-ammo-ag shotgun-ammo-lod0-jg 0)
(def-art-elt shotgun-ammo-ag shotgun-ammo-lod0-mg 1)
(def-art-elt shotgun-ammo-ag shotgun-ammo-idle-ja 2)

(defskelgroup *shotgun-ammo-sg* shotgun-ammo shotgun-ammo-lod0-jg shotgun-ammo-idle-ja
              ((shotgun-ammo-lod0-mg (meters 9999999)))
              :bounds (static-spherem 0 0 0 5))

(def-art-elt revolver-ammo-ag revolver-ammo-lod0-jg 0)
(def-art-elt revolver-ammo-ag revolver-ammo-lod0-mg 1)
(def-art-elt revolver-ammo-ag revolver-ammo-idle-ja 2)

(defskelgroup *revolver-ammo-sg* revolver-ammo revolver-ammo-lod0-jg revolver-ammo-idle-ja
              ((revolver-ammo-lod0-mg (meters 9999999)))
              :bounds (static-spherem 0 0 0 5))

(def-art-elt gauss-ammo-ag gauss-ammo-lod0-jg 0)
(def-art-elt gauss-ammo-ag gauss-ammo-lod0-mg 1)
(def-art-elt gauss-ammo-ag gauss-ammo-idle-ja 2)

(defskelgroup *gauss-ammo-sg* gauss-ammo gauss-ammo-lod0-jg gauss-ammo-idle-ja
              ((gauss-ammo-lod0-mg (meters 9999999)))
              :bounds (static-spherem 0 0 0 5))

(defun get-ammo-skelgroup ((type ammo-type))
  (case type
    (((ammo-type smg-grenade))
      *smg-grenade-ammo-sg*)
    (((ammo-type pistol))
      *pistol-clip-sg*)
    (((ammo-type shotgun))
      *shotgun-ammo-sg*)
    (((ammo-type revolver))
      *revolver-ammo-sg*)
    (((ammo-type gauss))
      *gauss-ammo-sg*)
    )
    )

(defmethod initialize-params ((this hl-ammo-collectable) (arg0 time-frame) (arg1 float))
  (logclear! (-> this mask) (process-mask crate enemy platform ambient))
  (logior! (-> this mask) (process-mask collectable))
  (set! (-> this flags) (collectable-flags can-collect))
  (set! (-> this bob-amount) arg1)
  (set! (-> this bob-offset)
        (+ (the-as int (-> this root trans x)) (the-as int (-> this root trans y)) (the-as int (-> this root trans z))))
  (cond
    ((or (= (vector-length (-> this root transv)) 0.0) (logtest? (-> this fact options) (fact-options instant-collect)))
     (vector-reset! (-> this root transv)))
    (else
     (logior! (-> this flags) (collectable-flags trans))
     (logclear! (-> this flags) (collectable-flags can-collect))
     (logclear! (-> this mask) (process-mask actor-pause))
     (set! (-> this bob-amount) 0.0)))
  (when (and (> arg0 0) #t)
    (logior! (-> this flags) (collectable-flags fade))
    (set! (-> this fadeout-timeout) arg0))
  (set! (-> this collect-timeout) (seconds 0.33))
  (set-time! (-> this birth-time))
  (set! (-> this base quad) (-> this root trans quad))
  (set! (-> this old-base quad) (-> this root trans quad))
  (set! (-> this pickup-handle) (the-as handle #f))
  #|(if (logtest? (-> this fact options) (fact-options large))
    (set! (-> this root root-prim local-sphere w) (* 2.5 (-> this root root-prim local-sphere w))))|#
  (none))

(defmethod init-collision! ((this hl-ammo-collectable))
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 no-reaction) (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((s4-0 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> s4-0 prim-core collide-as) (collide-kind powerup blue-eco-suck))
      (set! (-> s4-0 collide-with) (collide-kind target))
      (set! (-> s4-0 prim-core offense) (collide-offense touch))
      (set! (-> s4-0 transform-index) 0)
      (set-vector! (-> s4-0 local-sphere) 0.0 0.0 0.0 5720.3201)
      (set-root-prim! s5-0 s4-0))
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (backup-collide-with-as s5-0)
    (set! (-> s5-0 event-self) 'touched)
    (set! (-> s5-0 max-iteration-count) (the-as uint 1))
    (set! (-> this root) s5-0)))

(defmethod init-from-entity! ((this hl-ammo-collectable) (e entity-actor))
  (logior! (-> this mask) (process-mask enemy))
  (set! (-> this fact) (new 'process 'fact-info this (-> this pickup-type) (-> this pickup-amount)))
  (init-collision! this)
  (process-drawable-from-entity! this e)
  (set! (-> this bob-amount) 1024.0)
  (set! (-> this bob-offset)
        (+ (the int (-> this root trans x)) (the int (-> this root trans y)) (the int (-> this root trans z))))
  (set-time! (-> this birth-time))
  (vector-copy! (-> this base) (-> this root trans))
  (vector-copy! (-> this old-base) (-> this root trans))
  ;;(initialize-skeleton this (get-ammo-skelgroup ammo-type) '())
  (logclear! (-> this mask) (process-mask actor-pause))
  (initialize-params this 0 (the-as float 1024.0))
  (transform-post)
  (go-virtual wait :proc this)
  (none))

(defbehavior can-pickup? hl-ammo-collectable ()
  (when (can-pickup-ammo? (-> self ammo-type))
    (go-virtual pickup #f (the-as handle #f))))

(defbehavior hl-ammo-collectable-init-by-other hl-ammo-collectable ((pos vector) (ammo-type ammo-type) (crate-id string))
  (logior! (-> self mask) (process-mask enemy))
  (set! (-> self fact) (new 'process 'fact-info self (-> self pickup-type) (-> self pickup-amount)))
  (init-collision! self)
  (initialize-skeleton self (get-ammo-skelgroup ammo-type) '())
  (set! (-> self ammo-type) ammo-type)
  (set! (-> self crate-id) crate-id)
  (vector-copy! (-> self root trans) pos)
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (set! (-> self bob-amount) 1024.0)
  (set! (-> self bob-offset)
        (+ (the int (-> self root trans x)) (the int (-> self root trans y)) (the int (-> self root trans z))))
  (set-time! (-> self birth-time))
  (vector-copy! (-> self base) (-> self root trans))
  (vector-copy! (-> self old-base) (-> self root trans))
  (logclear! (-> self mask) (process-mask actor-pause))
  (initialize-params self 0 (the-as float 1024.0))
  (transform-post)
  (go-virtual wait))

(defstate wait (hl-ammo-collectable)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (local-vars (v0-3 object))
      (when (and (or (= message 'touch) (= message 'attack))
                 (and (logtest? (-> self flags) (collectable-flags can-collect))
                      (time-elapsed? (-> self birth-time) (-> self collect-timeout))
                      (!= (-> self next-state name) 'pickup)
                      (send-event proc 'get-pickup (-> self fact pickup-type) (-> self fact pickup-amount))))
        (logclear! (-> self mask) (process-mask actor-pause))
        (can-pickup?)
        
        )
      (cond
        ((= message 'eco-blue)
         (when (and (not (logtest? (-> self flags) (collectable-flags fading ignore-blue)))
                    (!= (-> self next-state name) 'pickup)
                    (begin
                      (check-blue-suck (the-as process-drawable proc))
                      #t)
                    (logtest? (-> self flags) (collectable-flags can-collect))
                    (time-elapsed? (-> self birth-time) (-> self collect-timeout))
                    (can-pickup?))
           (logclear! (-> self mask) (process-mask actor-pause))
           (go-virtual notice-blue (process->handle proc))
           ))
        ((= message 'trans)
         (set! (-> self root trans quad) (-> (the-as vector (-> block param 0)) quad))
         (update-transforms! (-> self root))
         (ja-post))
        ((= message 'jump)
         (logclear! (-> self mask) (process-mask actor-pause))
         (set! (-> self jump-pos quad) (-> (the-as vector (-> block param 0)) quad))
         (go-virtual jump))
        ((= message 'pickup)
         (when (!= (-> self next-state name) 'pickup)
           (if (and (> argc 0) (-> block param 0)) (move-to-point! (-> self root) (the-as vector (-> block param 0))))
           (logclear! (-> self mask) (process-mask actor-pause))
           (can-pickup?)))
        ((= message 'die) (logclear! (-> self mask) (process-mask actor-pause)) (go-virtual die))
        ((= message 'movie-pos) (set! v0-3 (-> block param 0)) (set! (-> self movie-pos-index) (the-as int v0-3)) v0-3)
        ((= message 'actor-pause)
         (cond
           ((-> block param 0)
            (logior! (-> self mask) (process-mask actor-pause))
            (set! v0-3 #t)
            (set! (-> self actor-pause) (the-as symbol v0-3))
            v0-3)
           (else (logclear! (-> self mask) (process-mask actor-pause)) (set! (-> self actor-pause) #f) #f)))
        ((= message 'fade)
         (logior! (-> self flags) (collectable-flags fade))
         (set! (-> self fadeout-timeout) (seconds 0.1))
         (set! v0-3 (current-time))
         (set! (-> self birth-time) (the-as time-frame v0-3))
         v0-3)))
  :enter
    (behavior ()
      (set-time! (-> self wait-enter-time))
      (if (and (logtest? (-> self fact options) (fact-options instant-collect can-collect))
               (logtest? (-> self flags) (collectable-flags can-collect))
               (!= (-> self next-state name) 'pickup)
               (send-event *target* 'get-pickup (-> self fact pickup-type) (-> self fact pickup-amount))
               )
        (can-pickup?)
        
        ))
  :code
    (behavior ()
      (loop
        (quaternion-rotate-y! (-> self root quat) (-> self root quat) (* (degrees 45) (seconds-per-frame)))
        (let ((bob (-> self bob-amount)))
          (when (< 0.0 bob)
            (set! (-> self root trans y)
                  (+ (-> self base y)
                     (* bob
                        (sin (* 109.22667 (the float (mod (+ (- (current-time) (-> self birth-time)) (-> self bob-offset)) (seconds 2))))))))
            (update-transforms! (-> self root))))
        ; (debug-draw-tris (-> (res-lump-struct (-> self draw art-group data 0 extra) 'collide-mesh-group (array collide-mesh)) 0) self 2)
        ; (dotimes (i (-> self node-list length))
        ;   (let* ((joint (-> self node-list data i)) (jpos (vector<-cspace! (new-stack-vector0) joint)))
        ;     (add-debug-sphere #t (bucket-id debug) jpos (meters 0.1) (static-rgba 0 #xff 0 #x40))
        ;     (add-debug-text-sphere (!= (-> joint joint) #f) (bucket-id debug) jpos (meters 0.1) (-> joint joint name) (static-rgba 0 #xff 0 #x40))
        ;     )
        ;   )
        (when (and (time-elapsed? (-> self wait-enter-time) (seconds 5.0)) 
          (process-by-name (-> self crate-id) *active-pool*)) (go-virtual die))
        (suspend))
        )
  :post transform-post)

(defstate notice-blue (hl-ammo-collectable)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (when (and (or (= message 'touch) (= message 'attack))
                 (and (logtest? (-> self flags) (collectable-flags can-collect))
                      (time-elapsed? (-> self birth-time) (-> self collect-timeout))
                      (!= (-> self next-state name) 'pickup)
                      (send-event proc 'get-pickup (-> self fact pickup-type) (-> self fact pickup-amount))))
        (logclear! (-> self mask) (process-mask actor-pause))
        (go-virtual pickup #f (process->handle proc))))
  :enter
    (behavior ((arg0 handle))
      (set! (-> self target) arg0)
      (set! (-> self speed quad) (the-as uint128 0))
      (set! (-> self speed z) (the-as float (if (rand-vu-percent? (the-as float 0.5)) 1.0 -1.0)))
      (set! (-> self suck-y-offset) 0.0)
      (logclear! (-> self mask) (process-mask actor-pause)))
  :exit
    (behavior ()
      (if (-> self actor-pause) (logior! (-> self mask) (process-mask actor-pause))))
  :trans
    (behavior ()
      (let ((a1-0 (new 'stack-no-clear 'event-message-block)))
        (set! (-> a1-0 from) self)
        (set! (-> a1-0 num-params) 2)
        (set! (-> a1-0 message) 'query)
        (set! (-> a1-0 param 0) (the-as uint 'powerup))
        (set! (-> a1-0 param 1) (the-as uint 3))
        (if (or (and (not (send-event-function *target* a1-0)) (not (logtest? (-> self flags) (collectable-flags suck)))) (not (can-pickup-ammo? (-> self ammo-type))))
          (go-virtual wait))))
  :code
    (behavior ((arg0 handle))
      (loop
        (set! (-> self root trans quad) (-> self base quad))
        (add-blue-motion #t #f #t #f)
        (update-transforms! (-> self root))
        (if (nonzero? (-> self draw)) (ja-post))
        (let ((a0-5 (-> self part))
              (a1-1 (-> self root root-prim prim-core)))
          (if (nonzero? a0-5) (spawn a0-5 (the-as vector a1-1))))
        (if (nonzero? (-> self sound)) (update! (-> self sound)))
        (suspend))))

(defun slot->y ((slot int))
  (- hl-hud-pickup-notice-base-pos
     (* slot hl-hud-pickup-notice-spacing)))

(defun alloc-hud-slot ()
  (cond
    ((not (logtest? *hl-hud-pickup-slots* hl-hud-slot-1))
      (logior! *hl-hud-pickup-slots* hl-hud-slot-1)
      0)

    ((not (logtest? *hl-hud-pickup-slots* hl-hud-slot-2))
      (logior! *hl-hud-pickup-slots* hl-hud-slot-2)
      1)

    ((not (logtest? *hl-hud-pickup-slots* hl-hud-slot-3))
      (logior! *hl-hud-pickup-slots* hl-hud-slot-3)
      2)

    ((not (logtest? *hl-hud-pickup-slots* hl-hud-slot-4))
      (logior! *hl-hud-pickup-slots* hl-hud-slot-4)
      3)

    ((not (logtest? *hl-hud-pickup-slots* hl-hud-slot-5))
      (logior! *hl-hud-pickup-slots* hl-hud-slot-5)
      4)

    ((not (logtest? *hl-hud-pickup-slots* hl-hud-slot-6))
      (logior! *hl-hud-pickup-slots* hl-hud-slot-6)
      5)

    ((not (logtest? *hl-hud-pickup-slots* hl-hud-slot-7))
      (logior! *hl-hud-pickup-slots* hl-hud-slot-7)
      6)

    ((not (logtest? *hl-hud-pickup-slots* hl-hud-slot-8))
      (logior! *hl-hud-pickup-slots* hl-hud-slot-8)
      7)

    ;; all occupied
    (else 7)))

(defun free-hud-slot (slot)
  (case slot
    ((0)
      (logclear! *hl-hud-pickup-slots* hl-hud-slot-1))

    ((1)
      (logclear! *hl-hud-pickup-slots* hl-hud-slot-2))

    ((2)
      (logclear! *hl-hud-pickup-slots* hl-hud-slot-3))

    ((3)
      (logclear! *hl-hud-pickup-slots* hl-hud-slot-4))

    ((4)
      (logclear! *hl-hud-pickup-slots* hl-hud-slot-5))

    ((5)
      (logclear! *hl-hud-pickup-slots* hl-hud-slot-6))

    ((6)
      (logclear! *hl-hud-pickup-slots* hl-hud-slot-7))

    ((7)
      (logclear! *hl-hud-pickup-slots* hl-hud-slot-8))))

(defstate pickup (hl-ammo-collectable)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    )
  :enter
    (behavior ((arg0 object) (arg1 handle))
      (when (not (can-pickup-ammo? (-> self ammo-type)))
        (go-virtual wait))

      (set-time! (-> self pickup-enter-time))

      (play-mod-sound "9mmclip1")

      (logior! (-> self draw status)
                (draw-status hidden))

      (set! (-> self hud-slot)
            (alloc-hud-slot))
      (when (= (-> self hud-slot) 7)

        (+! *hl-hud-slot-8-generation* 1)

        (set! (-> self hud-generation)
              *hl-hud-slot-8-generation*))    
      )
  :code
    (behavior ()
      (let ((hud-pos (slot->y (-> self hud-slot)))
          (pickup-amount (get-pickup-amount self)))
      (send-ammo-pickup-event self)
      (while (or (not (time-elapsed? (-> self pickup-enter-time) (seconds 2))))
        (when (or
                (not (= (-> self hud-slot) 7))
                (= (-> self hud-generation)
                  *hl-hud-slot-8-generation*))
              (with-dma-buffer-add-bucket ((testbuf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf))
              (draw-string-xy-scaled
                (get-pickup-text self pickup-amount)
                testbuf
                370
                hud-pos
                (the font-color 4)
                (font-flags shadow kerning)
                1.2)
              ))
        (suspend))
        (free-hud-slot (-> self hud-slot))
        (go-virtual die)))
)

(defun count-valid-ammo-types ()
  (let ((count 0))

    ;; pistol ammo
    (when (or (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons pistol))
              (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons smg)))
      (+! count 1))

    ;; smg grenade
    (when (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons smg))
      (+! count 1))

    ;; gauss ammo
    (when (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons gauss))
      (+! count 1))

    ;; revolver ammo
    (when (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons revolver))
      (+! count 1))

    ;; shotgun ammo
    (when (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons shotgun))
      (+! count 1))

    count))

(defun get-nth-valid-ammo-type (n)
  (let ((idx 0))

    ;; pistol ammo (shared with smg)
    (when (or (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons pistol))
              (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons smg)))
      (when (= idx n) (return (ammo-type pistol)))
      (+! idx 1))

    ;; smg grenade
    (when (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons smg))
      (when (= idx n) (return (ammo-type smg-grenade)))
      (+! idx 1))

    ;; gauss
    (when (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons gauss))
      (when (= idx n) (return (ammo-type gauss)))
      (+! idx 1))

    ;; revolver
    (when (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons revolver))
      (when (= idx n) (return (ammo-type revolver)))
      (+! idx 1))

    ;; shotgun
    (when (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons shotgun))
      (when (= idx n) (return (ammo-type shotgun)))
      (+! idx 1))

    -1))

(defun ammo-valid? ((ammo ammo-type))
  (case ammo
    ;; pistol ammo shared with smg
    (((ammo-type pistol))
      (or (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons pistol))
          (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons smg))))

    (((ammo-type smg-grenade))
      (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons smg)))

    (((ammo-type gauss))
      (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons gauss)))

    (((ammo-type revolver))
      (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons revolver)))

    (((ammo-type shotgun))
      (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons shotgun)))

    (else #f))
    )

(defun ammo-ratio ((ammo ammo-type))
  (let ((max (the float (get-max-ammo ammo)))
        (current-ammo (the float (get-current-ammo ammo))))
    (if (<= max 0.0)
        1.0
        (/ current-ammo
           max))))

(defun ammo-need-score ((ammo ammo-type))
  (if (not (ammo-valid? ammo))
      0.0
      (max 0.1
           (- 1.0 (the-as float (ammo-ratio ammo))))))

(defun pick-ammo-type ()
  (let ((total 0.0))

    (let ((pistol (ammo-type pistol))
          (smg-grenade (ammo-type smg-grenade))
          (gauss (ammo-type gauss))
          (revolver (ammo-type revolver))
          (shotgun (ammo-type shotgun)))

      (when (ammo-valid? pistol)
        (+! total (ammo-need-score pistol)))

      (when (ammo-valid? smg-grenade)
        (+! total (ammo-need-score smg-grenade)))

      (when (ammo-valid? gauss)
        (+! total (ammo-need-score gauss)))

      (when (ammo-valid? revolver)
        (+! total (ammo-need-score revolver)))

      (when (ammo-valid? shotgun)
        (+! total (ammo-need-score shotgun)))

      (if (<= total 0.0)
          (let ((count (count-valid-ammo-types)))
            (if (> count 0)
                (let ((r (rand-vu-int-range 0 (- count 1))))
                  (get-nth-valid-ammo-type r))
                -1))
          (let ((r (rand-vu-float-range 0.0 total))
                (accum 0.0))

            (when (ammo-valid? pistol)
              (+! accum (ammo-need-score pistol))
              (when (<= r accum)
                (return pistol)))

            (when (ammo-valid? smg-grenade)
              (+! accum (ammo-need-score smg-grenade))
              (when (<= r accum)
                (return smg-grenade)))

            (when (ammo-valid? gauss)
              (+! accum (ammo-need-score gauss))
              (when (<= r accum)
                (return gauss)))

            (when (ammo-valid? shotgun)
              (+! accum (ammo-need-score shotgun))
              (when (<= r accum)
                (return shotgun)))

            (when (ammo-valid? revolver)
              (+! accum (ammo-need-score revolver))
              (when (<= r accum)
                (return revolver)))

            pistol)))))

(defun spawn-hl-ammo ((pos vector) (crate-id string))
  (let ((ammo-type (pick-ammo-type)))
    (when (and (>= ammo-type 0) (not (-> *pc-settings* unlimited-ammo?)))
      (process-spawn hl-ammo-collectable pos (the-as ammo-type ammo-type) crate-id)))
  (none))

(defun spawn-hl-ammo-by-type-on-target ((type ammo-type))
    (let ((ammo-spawn-pos (new 'stack-no-clear 'vector)))
      (set-vector! ammo-spawn-pos (-> *target* root trans x) (+ (-> *target* root trans y) (meters 1.0)) (-> *target* root trans z) (-> *target* root trans w))
      (process-spawn hl-ammo-collectable ammo-spawn-pos type))
    (none))

(defmethod send-ammo-pickup-event ((this hl-ammo-collectable))
  (case (-> this ammo-type)
    (((ammo-type smg-grenade))
      (send-event (process-by-name "hl-weapon-proc" *active-pool*) 'pickup-smg-grenade 0 this))
    (((ammo-type pistol))
      (send-event (process-by-name "hl-weapon-proc" *active-pool*) 'pickup-9mm-ammo 0 this))
    (((ammo-type shotgun))
      (send-event (process-by-name "hl-weapon-proc" *active-pool*) 'pickup-shotgun-ammo 0 this))
    (((ammo-type revolver))
      (send-event (process-by-name "hl-weapon-proc" *active-pool*) 'pickup-revolver-ammo 0 this))
    (((ammo-type gauss))
      (send-event (process-by-name "hl-weapon-proc" *active-pool*) 'pickup-gauss-ammo 0 this)))
  (none)
)

(defmethod get-pickup-text ((this hl-ammo-collectable) (amount int))
  (case (-> this ammo-type)
    (((ammo-type smg-grenade))
      (string-format "+~d SMG GRENADE" amount))
    (((ammo-type pistol))
      (string-format "+~d 9MM AMMO" amount))
    (((ammo-type shotgun))
      (string-format "+~d SHOTGUN AMMO" amount))
    (((ammo-type revolver))
      (string-format "+~d .357 AMMO" amount))
    (((ammo-type gauss))
      (string-format "+~d GAUSS AMMO" amount))
    (else (string-format ""))  
    )
)

(defmethod get-pickup-amount ((this hl-ammo-collectable))
  (case (-> this ammo-type)
    (((ammo-type smg-grenade))
      (min 2 (- smg-grenade-max-ammo (-> *hl-weapons* current-smg-grenade-ammo))))
    (((ammo-type pistol))
      (min 20 (- 9mm-max-ammo (-> *hl-weapons* current-9mm-ammo))))
    (((ammo-type shotgun))
      (min 12 (- shotgun-max-ammo (-> *hl-weapons* current-shotgun-ammo))))
    (((ammo-type revolver))
      (min 6 (- revolver-max-ammo (-> *hl-weapons* current-revolver-ammo))))
    (((ammo-type gauss))
      (min 20 (- gauss-max-mag-ammo (-> *hl-weapons* current-gauss-mag-ammo))))
    (else 0)  
    )
)
