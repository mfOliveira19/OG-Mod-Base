(in-package goal)

(deftype hl-weapon-collectable (eco-collectable)
  ((weapon-type weapons-enum))
  (:methods
    (init-collision! (_type_) object)
    (send-weapon-pickup-event (_type_) none)))

(def-art-elt pistol-pickup-ag pistol-pickup-lod0-jg 0)
(def-art-elt pistol-pickup-ag pistol-pickup-lod0-mg 1)
(def-art-elt pistol-pickup-ag pistol-pickup-idle-ja 2)

(defskelgroup *pistol-pickup-sg* pistol-pickup pistol-pickup-lod0-jg pistol-pickup-idle-ja
              ((pistol-pickup-lod0-mg (meters 9999999)))
              :bounds (static-spherem 0 0 0 5))

(def-art-elt smg-pickup-ag smg-pickup-lod0-jg 0)
(def-art-elt smg-pickup-ag smg-pickup-lod0-mg 1)
(def-art-elt smg-pickup-ag smg-pickup-idle-ja 2)

(defskelgroup *smg-pickup-sg* smg-pickup smg-pickup-lod0-jg smg-pickup-idle-ja
              ((smg-pickup-lod0-mg (meters 9999999)))
              :bounds (static-spherem 0 0 0 5))

(def-art-elt revolver-pickup-ag revolver-pickup-lod0-jg 0)
(def-art-elt revolver-pickup-ag revolver-pickup-lod0-mg 1)
(def-art-elt revolver-pickup-ag revolver-pickup-idle-ja 2)

(defskelgroup *revolver-pickup-sg* revolver-pickup revolver-pickup-lod0-jg revolver-pickup-idle-ja
              ((revolver-pickup-lod0-mg (meters 9999999)))
              :bounds (static-spherem 0 0 0 5))

(def-art-elt shotgun-pickup-ag shotgun-pickup-lod0-jg 0)
(def-art-elt shotgun-pickup-ag shotgun-pickup-lod0-mg 1)
(def-art-elt shotgun-pickup-ag shotgun-pickup-idle-ja 2)

(defskelgroup *shotgun-pickup-sg* shotgun-pickup shotgun-pickup-lod0-jg shotgun-pickup-idle-ja
              ((shotgun-pickup-lod0-mg (meters 9999999)))
              :bounds (static-spherem 0 0 0 5))

(def-art-elt gauss-pickup-ag gauss-pickup-lod0-jg 0)
(def-art-elt gauss-pickup-ag gauss-pickup-lod0-mg 1)
(def-art-elt gauss-pickup-ag gauss-pickup-idle-ja 2)

(defskelgroup *gauss-pickup-sg* gauss-pickup gauss-pickup-lod0-jg gauss-pickup-idle-ja
              ((gauss-pickup-lod0-mg (meters 9999999)))
              :bounds (static-spherem 0 0 0 5))

(defun get-weapon-skelgroup ((type weapons-enum))
  (case type
    (((weapons-enum pistol))
      *pistol-pickup-sg*)
    (((weapons-enum smg))
      *smg-pickup-sg*)
    (((weapons-enum shotgun))
      *shotgun-pickup-sg*)
    (((weapons-enum revolver))
      *revolver-pickup-sg*)
    (((weapons-enum gauss))
      *gauss-pickup-sg*)
    )
  )

(defmethod initialize-params ((this hl-weapon-collectable) (arg0 time-frame) (arg1 float))
  (logclear! (-> this mask) (process-mask crate enemy platform ambient))
  (logior! (-> this mask) (process-mask collectable))
  (set! (-> this flags) (collectable-flags can-collect))
  (set! (-> this bob-amount) arg1)
  (set! (-> this bob-offset)
        (+ (the-as int (-> this root trans x)) (the-as int (-> this root trans y)) (the-as int (-> this root trans z))))
  (cond
    ((or (= (vector-length (-> this root transv)) 0.0) (logtest? (-> this fact options) (fact-options instant-collect)))
     (vector-reset! (-> this root transv)))
    (else
     (logior! (-> this flags) (collectable-flags trans))
     (logclear! (-> this flags) (collectable-flags can-collect))
     (logclear! (-> this mask) (process-mask actor-pause))
     (set! (-> this bob-amount) 0.0)))
  (when (and (> arg0 0) #t)
    (logior! (-> this flags) (collectable-flags fade))
    (set! (-> this fadeout-timeout) arg0))
  (set! (-> this collect-timeout) (seconds 0.33))
  (set-time! (-> this birth-time))
  (set! (-> this base quad) (-> this root trans quad))
  (set! (-> this old-base quad) (-> this root trans quad))
  (set! (-> this pickup-handle) (the-as handle #f))
  #|(if (logtest? (-> this fact options) (fact-options large))
    (set! (-> this root root-prim local-sphere w) (* 2.5 (-> this root root-prim local-sphere w))))|#
  (none))

(defmethod init-collision! ((this hl-weapon-collectable))
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 no-reaction) (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((s4-0 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> s4-0 prim-core collide-as) (collide-kind powerup))
      (set! (-> s4-0 collide-with) (collide-kind target))
      (set! (-> s4-0 prim-core offense) (collide-offense touch))
      (set! (-> s4-0 transform-index) 0)
      (set-vector! (-> s4-0 local-sphere) 0.0 0.0 0.0 5720.3201)
      (set-root-prim! s5-0 s4-0))
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (backup-collide-with-as s5-0)
    (set! (-> s5-0 event-self) 'touched)
    (set! (-> s5-0 max-iteration-count) (the-as uint 1))
    (set! (-> this root) s5-0)))

(defmethod init-from-entity! ((this hl-weapon-collectable) (e entity-actor))
  (logior! (-> this mask) (process-mask enemy))
  (set! (-> this fact) (new 'process 'fact-info this (-> this pickup-type) (-> this pickup-amount)))
  (init-collision! this)
  (process-drawable-from-entity! this e)
  (set! (-> this bob-amount) 1024.0)
  (set! (-> this bob-offset)
        (+ (the int (-> this root trans x)) (the int (-> this root trans y)) (the int (-> this root trans z))))
  (set-time! (-> this birth-time))
  (vector-copy! (-> this base) (-> this root trans))
  (vector-copy! (-> this old-base) (-> this root trans))
  ;;(initialize-skeleton this (get-weapon-skelgroup wea) '())
  (logclear! (-> this mask) (process-mask actor-pause))
  (initialize-params this 0 (the-as float 1024.0))
  (transform-post)
  (go-virtual wait :proc this)
  (none))

(defbehavior hl-weapon-collectable-init-by-other hl-weapon-collectable ((pos vector) (weapon-type weapons-enum))
  (logior! (-> self mask) (process-mask enemy))
  (set! (-> self fact) (new 'process 'fact-info self (-> self pickup-type) (-> self pickup-amount)))
  (logior! (-> self mask) (process-mask enemy))
  (init-collision! self)
  (initialize-skeleton self (get-weapon-skelgroup weapon-type) '())
  (set! (-> self weapon-type) weapon-type)
  (vector-copy! (-> self root trans) pos)
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (set! (-> self bob-amount) 1024.0)
  (set! (-> self bob-offset)
        (+ (the int (-> self root trans x)) (the int (-> self root trans y)) (the int (-> self root trans z))))
  (set-time! (-> self birth-time))
  (vector-copy! (-> self base) (-> self root trans))
  (vector-copy! (-> self old-base) (-> self root trans))
  (logclear! (-> self mask) (process-mask actor-pause))
  (initialize-params self 0 (the-as float 1024.0))
  (transform-post)
  (go-virtual wait))

(defbehavior hl-weapon-collectable-init-with-jump hl-weapon-collectable ((arg0 vector) (arg1 vector) (weapon-type weapons-enum))
  (logior! (-> self mask) (process-mask enemy))
  (set! (-> self fact) (new 'process 'fact-info self (-> self pickup-type) (-> self pickup-amount)))
  (init-collision! self)
  (initialize-skeleton self (get-weapon-skelgroup weapon-type) '())
  (set! (-> self weapon-type) weapon-type)
  (set! (-> self root trans quad) (-> arg0 quad))
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (set! (-> self bob-amount) 1024.0)
  (set! (-> self bob-offset)
        (+ (the int (-> self root trans x)) (the int (-> self root trans y)) (the int (-> self root trans z))))
  (set-time! (-> self birth-time))
  (vector-copy! (-> self base) (-> self root trans))
  (vector-copy! (-> self old-base) (-> self root trans))
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self root transv quad) (-> arg1 quad))
  (initialize-params self 0 (the-as float 1024.0))
  (update-transforms! (-> self root))
  (let ((gp-1 (res-lump-struct (-> self entity) 'movie-pos structure :time (the-as float -1000000000.0))))
    (cond
      ((and *debug-segment* (< (-> *fuel-cell-tune-pos* w) 1000000000.0))
       (set! (-> self jump-pos quad) (-> *fuel-cell-tune-pos* quad))
       (+! (-> self jump-pos y) 4096.0)
       (go-virtual jump))
      ((and gp-1
            (not (logtest? (res-lump-value (-> self entity) 'options fact-options :time (the-as float -1000000000.0))
                           (fact-options skip-jump-anim)))
            (not (logtest? (-> self fact options) (fact-options skip-jump-anim))))
       (set! (-> self jump-pos quad) (-> (the-as vector gp-1) quad))
       (+! (-> self jump-pos y) 4096.0)
       (go-virtual jump))))
  (set! (-> self event-hook) (-> (method-of-object self wait) event))
  (go-virtual wait)
  (none))

(defstate wait (hl-weapon-collectable)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (local-vars (v0-3 object))
      (when (and (or (= message 'touch) (= message 'attack))
                 (and (logtest? (-> self flags) (collectable-flags can-collect))
                      (time-elapsed? (-> self birth-time) (-> self collect-timeout))
                      (!= (-> self next-state name) 'pickup)
                      (send-event proc 'get-pickup (-> self fact pickup-type) (-> self fact pickup-amount))))
        (logclear! (-> self mask) (process-mask actor-pause))
        (go-virtual pickup #f (the-as handle #f))
        )
      (cond
        ((= message 'eco-blue)
         (when (and (not (logtest? (-> self flags) (collectable-flags fading ignore-blue)))
                    (!= (-> self next-state name) 'pickup)
                    (begin
                      (check-blue-suck (the-as process-drawable proc))
                      #t)
                    (logtest? (-> self flags) (collectable-flags can-collect))
                    (time-elapsed? (-> self birth-time) (-> self collect-timeout)))
           (logclear! (-> self mask) (process-mask actor-pause))
           (go-virtual notice-blue (process->handle proc))
           ))
        ((= message 'trans)
         (set! (-> self root trans quad) (-> (the-as vector (-> block param 0)) quad))
         (update-transforms! (-> self root))
         (ja-post))
        ((= message 'jump)
         (logclear! (-> self mask) (process-mask actor-pause))
         (set! (-> self jump-pos quad) (-> (the-as vector (-> block param 0)) quad))
         (go-virtual jump))
        ((= message 'pickup)
         (when (!= (-> self next-state name) 'pickup)
           (if (and (> argc 0) (-> block param 0)) (move-to-point! (-> self root) (the-as vector (-> block param 0))))
           (logclear! (-> self mask) (process-mask actor-pause)))
           (go-virtual pickup #f (the-as handle #f)))
        ((= message 'die) (logclear! (-> self mask) (process-mask actor-pause)) (go-virtual die))
        ((= message 'movie-pos) (set! v0-3 (-> block param 0)) (set! (-> self movie-pos-index) (the-as int v0-3)) v0-3)
        ((= message 'actor-pause)
         (cond
           ((-> block param 0)
            (logior! (-> self mask) (process-mask actor-pause))
            (set! v0-3 #t)
            (set! (-> self actor-pause) (the-as symbol v0-3))
            v0-3)
           (else (logclear! (-> self mask) (process-mask actor-pause)) (set! (-> self actor-pause) #f) #f)))
        ((= message 'fade)
         (logior! (-> self flags) (collectable-flags fade))
         (set! (-> self fadeout-timeout) (seconds 0.1))
         (set! v0-3 (current-time))
         (set! (-> self birth-time) (the-as time-frame v0-3))
         v0-3)))
  :enter
    (behavior ()
      (if (and (logtest? (-> self fact options) (fact-options instant-collect can-collect))
               (logtest? (-> self flags) (collectable-flags can-collect))
               (!= (-> self next-state name) 'pickup)
               (send-event *target* 'get-pickup (-> self fact pickup-type) (-> self fact pickup-amount))
               )
            (go-virtual pickup #f (the-as handle #f))
        ))
  :code
    (behavior ()
      (loop
        (quaternion-rotate-y! (-> self root quat) (-> self root quat) (* (degrees 45) (seconds-per-frame)))
        (let ((bob (-> self bob-amount)))
          (when (< 0.0 bob)
            (set! (-> self root trans y)
                  (+ (-> self base y)
                     (* bob
                        (sin (* 109.22667 (the float (mod (+ (- (current-time) (-> self birth-time)) (-> self bob-offset)) (seconds 2))))))))
            (update-transforms! (-> self root))))
        ; (debug-draw-tris (-> (res-lump-struct (-> self draw art-group data 0 extra) 'collide-mesh-group (array collide-mesh)) 0) self 2)
        ; (dotimes (i (-> self node-list length))
        ;   (let* ((joint (-> self node-list data i)) (jpos (vector<-cspace! (new-stack-vector0) joint)))
        ;     (add-debug-sphere #t (bucket-id debug) jpos (meters 0.1) (static-rgba 0 #xff 0 #x40))
        ;     (add-debug-text-sphere (!= (-> joint joint) #f) (bucket-id debug) jpos (meters 0.1) (-> joint joint name) (static-rgba 0 #xff 0 #x40))
        ;     )
        ;   )
        (suspend))
        )
  :post transform-post)

(defstate notice-blue (hl-weapon-collectable)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (when (and (or (= message 'touch) (= message 'attack))
                 (and (logtest? (-> self flags) (collectable-flags can-collect))
                      (time-elapsed? (-> self birth-time) (-> self collect-timeout))
                      (!= (-> self next-state name) 'pickup)
                      (send-event proc 'get-pickup (-> self fact pickup-type) (-> self fact pickup-amount))))
        (logclear! (-> self mask) (process-mask actor-pause))
        (go-virtual pickup #f (process->handle proc))))
  :enter
    (behavior ((arg0 handle))
      (set! (-> self target) arg0)
      (set! (-> self speed quad) (the-as uint128 0))
      (set! (-> self speed z) (the-as float (if (rand-vu-percent? (the-as float 0.5)) 1.0 -1.0)))
      (set! (-> self suck-y-offset) 0.0)
      (logclear! (-> self mask) (process-mask actor-pause)))
  :exit
    (behavior ()
      (if (-> self actor-pause) (logior! (-> self mask) (process-mask actor-pause))))
  :trans
    (behavior ()
      (let ((a1-0 (new 'stack-no-clear 'event-message-block)))
        (set! (-> a1-0 from) self)
        (set! (-> a1-0 num-params) 2)
        (set! (-> a1-0 message) 'query)
        (set! (-> a1-0 param 0) (the-as uint 'powerup))
        (set! (-> a1-0 param 1) (the-as uint 3))
        (if (or (and (not (send-event-function *target* a1-0)) (not (logtest? (-> self flags) (collectable-flags suck)))))
          (go-virtual wait))))
  :code
    (behavior ((arg0 handle))
      (loop
        (set! (-> self root trans quad) (-> self base quad))
        (add-blue-motion #t #f #t #f)
        (update-transforms! (-> self root))
        (if (nonzero? (-> self draw)) (ja-post))
        (let ((a0-5 (-> self part))
              (a1-1 (-> self root root-prim prim-core)))
          (if (nonzero? a0-5) (spawn a0-5 (the-as vector a1-1))))
        (if (nonzero? (-> self sound)) (update! (-> self sound)))
        (suspend))))

(defstate pickup (hl-weapon-collectable)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    )
  :enter
    (behavior ((arg0 object) (arg1 handle))
      (play-mod-sound "pickup")
      (send-weapon-pickup-event self)
      (go-virtual die)
    )
  :code
    (behavior ()
    )
)

(defstate die (hl-weapon-collectable)
  :virtual #t
  :code
    (behavior ()
      (process-entity-status! self (entity-perm-status dead) #t)))

(defun spawn-hl-weapons-collectable ()
    (unless (-> *pc-settings* all-weapons?)
      ;; Geyser pistol
      (when (and (not (process-by-name 'pistol-geyser-collectable *active-pool*)) (not (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons pistol))))
        (process-spawn hl-weapon-collectable (set-vector! (new 'stack-no-clear 'vector) (meters -1299.28) (meters 53.36) (meters 1003.87) 0.0) (weapons-enum pistol) :name 'pistol-geyser-collectable))

      ;; Sandover shotgun
      (when (and (not (process-by-name 'shotgun-sandover-collectable *active-pool*)) (not (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons shotgun))))
        (process-spawn hl-weapon-collectable (set-vector! (new 'stack-no-clear 'vector) (meters 80.12) (meters 19.22) (meters 16.86) 0.0) (weapons-enum shotgun) :name 'shotgun-sandover-collectable))

      ;; Sentinel smg
      (when (and (not (process-by-name 'smg-sentinel-collectable *active-pool*)) (not (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons smg))))
        (process-spawn hl-weapon-collectable (set-vector! (new 'stack-no-clear 'vector) (meters -272.53) (meters 44.51) (meters -297.07) 0.0) (weapons-enum smg) :name 'smg-sentinel-collectable))

      ;; Misty revolver
      (when (and (not (process-by-name 'revolver-misty-collectable *active-pool*)) (not (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons revolver))))
        (process-spawn hl-weapon-collectable (set-vector! (new 'stack-no-clear 'vector) (meters -134.17) (meters 41.09) (meters 912.73) 0.0) (weapons-enum revolver) :name 'revolver-misty-collectable))
      )
    (none)
)

(defun kill-hl-weapons-collectable ()
  (kill-by-name "pistol-geyser-collectable" *active-pool*)
  (kill-by-name "shotgun-sandover-collectable" *active-pool*)
  (kill-by-name "smg-sentinel-collectable" *active-pool*)
  (kill-by-name "revolver-basin-collectable" *active-pool*)
  (none)
)

(defmethod send-weapon-pickup-event ((this hl-weapon-collectable))
  (case (-> this weapon-type)
    (((weapons-enum pistol))
      (send-event (process-by-name "hl-weapon-proc" *active-pool*) 'pickup-pistol 0 this))
    (((weapons-enum smg))
      (send-event (process-by-name "hl-weapon-proc" *active-pool*) 'pickup-smg 0 this))
    (((weapons-enum shotgun))
      (send-event (process-by-name "hl-weapon-proc" *active-pool*) 'pickup-shotgun 0 this))
    (((weapons-enum revolver))
      (send-event (process-by-name "hl-weapon-proc" *active-pool*) 'pickup-revolver 0 this))
    (((weapons-enum gauss))
      (send-event (process-by-name "hl-weapon-proc" *active-pool*) 'pickup-gauss 0 this)))
  (none)
)

(defun spawn-gauss ((arg0 vector))
  (when (and (not (process-by-name 'gauss-plant-boss-collectable *active-pool*)) (not (logtest? (-> *hl-weapons* owned-weapons) (owned-weapons gauss))))
    (let ((s1-0 (new-stack-vector0)))
        (set-vector! s1-0 (meters -8.0) 57001.605 1.0 1.0)
        (set-vector! arg0 (-> arg0 x) (- (-> arg0 y) (meters 1.0)) (-> arg0 z) 0.0)
        (vector-rotate-around-y! s1-0 s1-0 (/ (* 65536.0 1.0) 1.0))
        (process-spawn hl-weapon-collectable :name 'gauss-plant-boss-collectable :init hl-weapon-collectable-init-with-jump arg0 s1-0 (weapons-enum gauss))))
  (none)
)

(defun spawn-hl-weapon-by-type-on-target ((type weapons-enum))
    (let ((weapon-spawn-pos (new 'stack-no-clear 'vector)))
      (set-vector! weapon-spawn-pos (-> *target* root trans x) (+ (-> *target* root trans y) (meters 1.0)) (-> *target* root trans z) (-> *target* root trans w))
      (process-spawn hl-weapon-collectable weapon-spawn-pos type))
    (none))
